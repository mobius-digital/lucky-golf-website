{%- liquid
  assign s = section.settings
  assign min = settings.lg_review_min | default: 10
  assign cards = section.blocks | where: 'type', 'card'
  assign rows = section.blocks | where: 'type', 'row'
  assign specs = section.blocks | where: 'type', 'spec'
  assign panels = section.blocks | where: 'type', 'panel'
  assign stars = ''
  capture stars
    render 'lg-stars'
  endcapture
-%}
<section class="lg-wrap band" id="{{ s.anchor }}">
  <header class="band-hd">
    <div>{%- if s.eyebrow != blank %}<p class="lg-eyebrow">{{ s.eyebrow }}</p>{% endif -%}{% render 'lg-h', text: s.heading, tag: 'h2', cls: 'lg-d2' %}</div>
    {%- if s.body != blank %}<p class="lg-body">{{ s.body }}</p>{% endif -%}
  </header>
  <div class="row{% if cards.size < 2 %} one{% endif %}">
    <figure class="shot">{%- if s.photo != blank -%}{{ s.photo | image_url: width: 1200 | image_tag: loading: 'lazy', alt: s.photo.alt, widths: '600,900,1200', sizes: '(max-width: 980px) 100vw, 40vw', style: s.photo_pos }}{%- else -%}<span class="lg-slot"><small>Photo</small>Pick one in the theme editor</span>{%- endif -%}</figure>
    {%- for block in cards -%}{%- assign b = block.settings -%}{%- assign p = b.product -%}{%- if p == blank -%}{%- continue -%}{%- endif -%}
      {%- liquid
        assign pic = b.image | default: p.metafields.custom.cutout.value | default: p.featured_image
        assign nm = b.name | default: p.title
        assign rc = p.metafields.reviews.rating_count.value | default: 0
        assign rv = p.metafields.reviews.rating.value.rating | default: 0
      -%}
      {%- if s.style == 'big' -%}
      <div class="lg-card-wrap" {{ block.shopify_attributes }}>{% render 'lg-bigcard', product: p, name: nm, line: b.line, vibe: b.vibe, image: b.image %}</div>
      {%- else -%}
      <article class="pc" {{ block.shopify_attributes }}>
        <a class="pc-ph" href="{{ p.url }}">{%- if p.available == false -%}<span class="lg-tag">Sold out</span>{%- elsif b.tag != blank -%}<span class="lg-tag">{{ b.tag }}</span>{%- endif -%}
          {%- if pic -%}{{ pic | image_url: width: 800 | image_tag: loading: 'lazy', alt: nm, widths: '400,600,800', sizes: '(max-width: 620px) 100vw, 30vw' }}{%- endif -%}
          {%- if b.vibe != blank %}<span class="lg-tag vibe">{{ b.vibe }}</span>{% endif %}</a>
        <div class="pc-bd">
          <div class="pc-top"><h3><a href="{{ p.url }}">{{ nm }}</a></h3><b>{{ p.price | money_without_trailing_zeros }}</b></div>
          {%- if rc >= min -%}<a class="pc-rate" href="{{ p.url }}#reviews"><span class="lg-stars" aria-label="{{ rv | round: 1 }} out of 5">{{ stars }}</span>{{ rv | round: 2 }} · {{ rc }}</a>{%- endif -%}
          {%- if b.line != blank %}<p>{{ b.line }}</p>{% endif -%}
          {%- if b.hud != blank -%}<div class="lg-hud">{%- assign hs = b.hud | newline_to_br | split: '<br />' -%}{%- for h in hs -%}{%- assign hp = h | split: '|' -%}{%- if hp.size > 1 %}<span><b>{{ hp.first | strip }}</b>{{ hp.last | strip }}</span>{% endif -%}{%- endfor -%}</div>{%- endif -%}
          {%- if p.available -%}
          <span class="lg-stock">In stock · ships in 1 to 2 days</span>
          <a class="lg-btn lg-btn-sm" href="{{ p.url }}">{{ b.cta }} <span aria-hidden="true">&rarr;</span></a>
          {%- else -%}
          <span class="lg-stock out">Sold out</span>
          <a class="lg-btn-line lg-btn-sm" href="{{ p.url }}">Tell me when it's back <span aria-hidden="true">&rarr;</span></a>
          {%- endif -%}
        </div>
      </article>
      {%- endif -%}
    {%- endfor -%}
  </div>
  {%- if rows.size > 0 and cards.size > 1 -%}
  {%- assign ca = cards[0].settings -%}{%- assign cb = cards[1].settings -%}{%- assign pa = ca.product -%}{%- assign pb = cb.product -%}
  {%- liquid
    assign na = pa.metafields.reviews.rating_count.value | default: 0
    assign nb = pb.metafields.reviews.rating_count.value | default: 0
    assign ra = pa.metafields.reviews.rating.value.rating | default: 0 | round: 2
    assign rb = pb.metafields.reviews.rating.value.rating | default: 0 | round: 2
    assign ia = ca.image | default: pa.metafields.custom.cutout.value | default: pa.featured_image
    assign ib = cb.image | default: pb.metafields.custom.cutout.value | default: pb.featured_image
  -%}
  <div class="h2h{% if s.cmp_diff %} hide-same{% endif %}" data-h2h>
    <div class="h2h-hd"><h3>{{ s.cmp_title }}</h3><label class="diff"><input type="checkbox" data-diff{% if s.cmp_diff %} checked{% endif %}> Only show what's different</label></div>
    <div class="tablewrap"><table class="lg-table">
      <thead><tr><th></th>
        <th scope="col"><a href="{{ pa.url }}">{%- if ia -%}{{ ia | image_url: width: 260 | image_tag: loading: 'lazy', alt: '' }}{%- endif -%}<span>{{ ca.name | default: pa.title }}</span></a></th>
        <th scope="col"><a href="{{ pb.url }}">{%- if ib -%}{{ ib | image_url: width: 260 | image_tag: loading: 'lazy', alt: '' }}{%- endif -%}<span>{{ cb.name | default: pb.title }}</span></a></th></tr></thead>
      <tbody>
        {%- for block in rows -%}{%- assign r = block.settings -%}
          {%- if r.same -%}<tr class="is-same" {{ block.shopify_attributes }}><th scope="row">{{ r.label }}</th><td colspan="2" class="same">{{ r.a }} <em>Same on both</em></td></tr>
          {%- else -%}<tr class="is-diff" {{ block.shopify_attributes }}><th scope="row">{{ r.label }}</th><td>{{ r.a }}</td><td>{{ r.b }}</td></tr>{%- endif -%}
          {%- if forloop.index == 2 and s.rating_label != blank -%}
            {%- if na == nb and ra == rb and na >= min -%}
            <tr class="is-same"><th scope="row">{{ s.rating_label }}</th><td colspan="2" class="same">{{ ra }} · {{ na }} reviews <em>{{ s.rating_same }}</em></td></tr>
            {%- elsif na >= min or nb >= min -%}
            <tr class="is-diff"><th scope="row">{{ s.rating_label }}</th><td>{% if na >= min %}{{ ra }} · {{ na }} reviews{% else %}Not enough reviews yet{% endif %}</td><td>{% if nb >= min %}{{ rb }} · {{ nb }} reviews{% else %}Not enough reviews yet{% endif %}</td></tr>
            {%- endif -%}
          {%- endif -%}
        {%- endfor -%}
      </tbody></table></div>
  </div>
  {%- endif -%}
  {%- if specs.size > 0 or panels.size > 0 -%}
  <div class="hy">
    <div class="lg-specs" style="grid-template-columns:repeat(2,minmax(0,1fr));align-content:start">
      {%- for block in specs -%}<div class="lg-spec" {{ block.shopify_attributes }}><b>{{ block.settings.b }}<small>{{ block.settings.small }}</small></b><span>{{ block.settings.label }}</span></div>{%- endfor -%}
    </div>
    <div class="replace">
      {%- for block in panels -%}<div class="lg-panel" {{ block.shopify_attributes }}>{%- if block.settings.tag != blank %}<span class="lg-tag">{{ block.settings.tag }}</span>{% endif %}<h4>{{ block.settings.title }}</h4><p>{{ block.settings.text }}</p></div>{%- endfor -%}
    </div>
  </div>
  {%- endif -%}
</section>
<script>
document.addEventListener('change', function(e){ var d = e.target.closest('[data-diff]'); if (!d || d.__lg) return;
  d.closest('[data-h2h]').classList.toggle('hide-same', d.checked); });
</script>
