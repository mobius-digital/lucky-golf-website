  <!-- ===================== HERO ===================== -->
  <section class="lgb-sec-tight lgb-band-ink bgo-hero">
    <span class="bgo-wm" aria-hidden="true"><svg><use href="#lgb-clover"/></svg></span>
    <div class="lgb-wrap">
      <p class="lgb-eyebrow on-dark">{{ section.settings.eyebrow }}</p>
      <h1 class="lgb-disp bgo-h1">{{ section.settings.heading }}</h1>
      <p class="bgo-lede">{{ section.settings.subheading }}</p>

      <div class="bgo-deal" aria-hidden="true">
        <span class="d paid" data-unit-price></span>
        <span class="op">+</span>
        <span class="d paid" data-unit-price></span>
        <span class="op">+</span>
        <span class="d free">$0</span>
        <span class="op">=</span>
        <span class="sum" data-deal-sum></span>
      </div>

      {%- if section.settings.facts != blank -%}
      <ul class="bgo-facts">
        {%- assign facts = section.settings.facts | split: ',' -%}
        {%- for f in facts -%}<li>{{ f | strip }}</li>{%- endfor -%}
      </ul>
      {%- endif -%}
    </div>
  </section>

  <!-- ===================== THE GRID ===================== -->
  <section class="lgb-sec bgo-body">
    <div class="lgb-wrap">
      <span class="lgb-eyebrow">{{ section.settings.grid_eyebrow }}</span>
      <h2 class="lgb-disp lgb-disp-m">{{ section.settings.grid_heading }}</h2>
      <p class="lgb-aside bgo-pick-aside">{{ section.settings.grid_note }}</p>
      <div class="bgo-grid" id="bgo-grid"></div>
      <noscript>
        <p class="bgo-lede" style="color:inherit">This bundle counter needs JavaScript.
          Every hat is also in the <a href="{{ hat_col.url }}">hats collection</a>.</p>
      </noscript>
    </div>
  </section>

  <div class="lgb-breath"><span class="ln"></span><span class="dot"></span><span class="ln"></span></div>

  <!-- ===================== CLUBS BAND ===================== -->
  <section class="lgb-sec lgb-band-cream bgo-up">
    <div class="lgb-wrap">
      <span class="lgb-eyebrow">{{ section.settings.band_eyebrow }}</span>
      <h2 class="lgb-disp lgb-disp-m">{{ section.settings.band_heading }}</h2>
      <p class="bgo-up-lede">{{ section.settings.band_sub }}</p>
      <div class="bgo-clubs" id="bgo-up-page"></div>
    </div>
  </section>

  <!-- ===================== PROGRESS RAIL =====================
       Fixed to the bottom edge for the life of the page. Sticky would only
       stick inside its own section; this has to survive the whole scroll. -->
  <div class="bgo-rail" id="bgo-rail" data-show="false" data-state="empty">
    <span class="flash" aria-hidden="true"></span>
    <div class="bgo-rail-in">
      <div class="bgo-slots" id="bgo-slots" aria-hidden="true"></div>
      <div class="bgo-status">
        <strong class="hd" id="bgo-hd">{{ section.settings.rail_empty }}</strong>
        <span class="sub" id="bgo-sub"></span>
      </div>
      <div class="bgo-rail-act">
        <span class="tot" id="bgo-tot" hidden>
          <span class="l">Bundle</span>
          <span class="v" id="bgo-tot-v"></span>
          <span class="sv" id="bgo-tot-sv"></span>
        </span>
        <a class="lgb-btn lgb-btn-foil lgb-btn-sm" id="bgo-go" href="{{ routes.cart_url }}" hidden>
          <span>{{ section.settings.cta_cart }}</span><span class="ar">&rarr;</span></a>
      </div>
    </div>
  </div>
  <p class="lgb-sr" id="bgo-live" role="status" aria-live="polite"></p>

  <!-- ===================== UPSELL MODAL =====================
       Fires when the third hat is IN, never at the unlock. A dialog at hat two
       covers the grid at the one moment the reader has to reach into it.
       Three flex rows so only the middle scrolls and the buttons never leave. -->
  <div class="bgo-md" id="bgo-md" hidden data-open="false" role="dialog" aria-modal="true" aria-labelledby="bgo-md-title">
    <div class="bgo-md-bd-scrim" data-bgo-close></div>
    <div class="bgo-md-panel">
      <button type="button" class="bgo-md-x" data-bgo-close aria-label="Close">&times;</button>
      <div class="bgo-md-hd">
        <span class="bgo-wm" aria-hidden="true"><svg><use href="#lgb-clover"/></svg></span>
        <p class="lgb-eyebrow on-dark">{{ section.settings.modal_eyebrow }}</p>
        <h2 class="lgb-disp lgb-disp-s" id="bgo-md-title">{{ section.settings.modal_heading }}</h2>
        <p>{{ section.settings.modal_sub }}</p>
      </div>
      <div class="bgo-md-bd">
        <div class="bgo-updeck" data-deck="apparel">
          <span class="lgb-eyebrow">{{ section.settings.deck_1_label }}</span>
          <div class="bgo-clubs" id="bgo-up-apparel"></div>
        </div>
        <div class="bgo-updeck" data-deck="club">
          <span class="lgb-eyebrow">{{ section.settings.deck_2_label }}</span>
          <div class="bgo-clubs" id="bgo-up-club"></div>
        </div>
      </div>
      <div class="bgo-md-foot">
        <button type="button" class="lgb-btn lgb-btn-line lgb-btn-sm" data-bgo-close><span>{{ section.settings.cta_back }}</span></button>
        <a class="lgb-btn lgb-btn-foil lgb-btn-sm" href="{{ routes.cart_url }}"><span>{{ section.settings.cta_cart }}</span><span class="ar">&rarr;</span></a>
      </div>
    </div>
  </div>

</div>

{{ 'bogo-hats.css' | asset_url | stylesheet_tag }}

<script src="{{ 'bogo-hats.js' | asset_url }}" defer></script>

{% schema %}
{
  "name": "BOGO hats bundle",
  "tag": "section",
  "settings": [
    { "type": "header", "content": "The bundle" },
    { "type": "collection", "id": "hats_collection", "label": "Hats collection",
      "info": "Every product here becomes a pickable tile. Single-variant products only." },
    { "type": "range", "id": "bundle_size", "label": "Buy this many, get one free",
      "min": 2, "max": 6, "step": 1, "default": 3,
      "info": "3 = buy 2 get 1. Must match the automatic discount in Discounts." },

    { "type": "header", "content": "Hero" },
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Buy two, get one free" },
    { "type": "text", "id": "heading", "label": "Headline", "default": "Nobody needs three hats. Take three anyway." },
    { "type": "textarea", "id": "subheading", "label": "Subheading",
      "default": "Two at $29, the third one's free. Ten to choose from, so pick the three that don't match." },
    { "type": "text", "id": "facts", "label": "Spec row (comma separated)",
      "default": "Five-panel snapback, Moisture-wicking sweatband, Laser-cut ventilation" },

    { "type": "header", "content": "Grid" },
    { "type": "text", "id": "grid_eyebrow", "label": "Eyebrow", "default": "All ten" },
    { "type": "text", "id": "grid_heading", "label": "Heading", "default": "Pick three" },
    { "type": "text", "id": "grid_note", "label": "Note",
      "default": "Want the same one twice? Nobody here is going to stop you." },

    { "type": "header", "content": "Progress bar" },
    { "type": "text", "id": "rail_empty", "label": "Starting message", "default": "Pick your first hat" },
    { "type": "text", "id": "cta_cart", "label": "Cart button", "default": "Go to the bag" },

    { "type": "header", "content": "Popup" },
    { "type": "text", "id": "modal_eyebrow", "label": "Eyebrow", "default": "Free one's in" },
    { "type": "text", "id": "modal_heading", "label": "Heading", "default": "You paid for two. Wear all three." },
    { "type": "textarea", "id": "modal_sub", "label": "Subheading",
      "default": "You're set on hats. What's left goes on you or in the bag." },
    { "type": "text", "id": "cta_back", "label": "Back button", "default": "Back to the hats" },

    { "type": "header", "content": "Upsell deck 1" },
    { "type": "text", "id": "deck_1_label", "label": "Label", "default": "Goes on you" },
    { "type": "product", "id": "apparel_1", "label": "Product 1" },
    { "type": "text", "id": "why_1", "label": "One-liner 1" },
    { "type": "product", "id": "apparel_2", "label": "Product 2" },
    { "type": "text", "id": "why_2", "label": "One-liner 2" },

    { "type": "header", "content": "Upsell deck 2" },
    { "type": "text", "id": "deck_2_label", "label": "Label", "default": "Goes in the bag" },
    { "type": "product", "id": "club_1", "label": "Product 3" },
    { "type": "text", "id": "why_3", "label": "One-liner 3" },
    { "type": "product", "id": "club_2", "label": "Product 4" },
    { "type": "text", "id": "why_4", "label": "One-liner 4" },

    { "type": "header", "content": "Clubs band (below the grid)" },
    { "type": "text", "id": "band_eyebrow", "label": "Eyebrow", "default": "Since you're here" },
    { "type": "text", "id": "band_heading", "label": "Heading", "default": "The hat was the easy part" },
    { "type": "textarea", "id": "band_sub", "label": "Subheading",
      "default": "A forged wedge for $99. Nobody's tour contract is buried in that number." }
  ],
  "presets": [{ "name": "BOGO hats bundle" }]
}
{% endschema %}
