{%- comment -%} The polo size guide (the approved chart). Opens from any [data-md-open="md-size"]; the page highlights the picked size with .on on [data-c]. {%- endcomment -%}
<div class="md" id="md-size" hidden role="dialog" aria-modal="true" aria-labelledby="md-size-t"><div class="md-bd" data-md-close></div><div class="md-panel sg">
  <button type="button" class="md-x" data-md-close aria-label="Close">&times;</button>
  <p class="lg-eyebrow">Size guide</p>
  <h2 class="lg-d2" id="md-size-t">Find your size</h2>
  <div class="sg-units lg-chips" role="group" aria-label="Units"><button class="lg-chip" type="button" data-unit="in" aria-pressed="true">Inches</button><button class="lg-chip" type="button" data-unit="cm" aria-pressed="false">Centimeters</button></div>
  <div class="sg-grid"><figure class="sg-fig"><svg viewBox="0 -6 200 226" role="img" aria-label="Where chest, length and shoulder are measured"><path class="sg-shirt" d="M72 28 L86 20 Q100 32 114 20 L128 28 L162 42 L182 86 L156 96 L150 82 L150 206 L50 206 L50 82 L44 96 L18 86 L38 42 Z"/><path class="sg-shirt" d="M86 20 L93 46 L100 38 L107 46 L114 20 M100 38 L100 70"/><g class="sg-m"><path d="M40 44 H160"/><path d="M40 39 V49 M160 39 V49"/><path d="M100 8 V16" class="lead"/><text x="100" y="4">Shoulder</text></g><g class="sg-m"><path d="M50 104 H150"/><path d="M50 99 V109 M150 99 V109"/><text x="100" y="98">Chest</text></g><g class="sg-m"><path d="M66 32 V206"/><path d="M61 32 H71 M61 206 H71"/><text x="72" y="150" class="v">Length</text></g></svg><figcaption>How to measure: lay the polo flat.</figcaption></figure>
  <div class="sg-tables"><div data-unit-panel="in"><table class="lg-table sg-tbl"><thead><tr><th scope="col">Inches</th><th scope="col" data-c="S">S</th><th scope="col" data-c="M">M</th><th scope="col" data-c="L">L</th><th scope="col" data-c="XL">XL</th><th scope="col" data-c="XXL">XXL</th><th scope="col" data-c="3XL">3XL</th></tr></thead><tbody><tr><th scope="row">Chest<small>flat, pit to pit</small></th><td data-c="S">20.5</td><td data-c="M">21.7</td><td data-c="L">22.8</td><td data-c="XL">24.0</td><td data-c="XXL">25.2</td><td data-c="3XL">26.4</td></tr><tr><th scope="row">Length<small>shoulder to hem</small></th><td data-c="S">28.3</td><td data-c="M">29.1</td><td data-c="L">29.9</td><td data-c="XL">30.7</td><td data-c="XXL">31.5</td><td data-c="3XL">32.3</td></tr><tr><th scope="row">Shoulder<small>seam to seam</small></th><td data-c="S">17.7</td><td data-c="M">18.5</td><td data-c="L">19.3</td><td data-c="XL">20.1</td><td data-c="XXL">20.9</td><td data-c="3XL">21.7</td></tr></tbody></table></div><div data-unit-panel="cm" hidden><table class="lg-table sg-tbl"><thead><tr><th scope="col">Centimeters</th><th scope="col" data-c="S">S</th><th scope="col" data-c="M">M</th><th scope="col" data-c="L">L</th><th scope="col" data-c="XL">XL</th><th scope="col" data-c="XXL">XXL</th><th scope="col" data-c="3XL">3XL</th></tr></thead><tbody><tr><th scope="row">Chest<small>flat, pit to pit</small></th><td data-c="S">52.1</td><td data-c="M">55.1</td><td data-c="L">57.9</td><td data-c="XL">61.0</td><td data-c="XXL">64.0</td><td data-c="3XL">67.1</td></tr><tr><th scope="row">Length<small>shoulder to hem</small></th><td data-c="S">71.9</td><td data-c="M">73.9</td><td data-c="L">75.9</td><td data-c="XL">78.0</td><td data-c="XXL">80.0</td><td data-c="3XL">82.0</td></tr><tr><th scope="row">Shoulder<small>seam to seam</small></th><td data-c="S">45.0</td><td data-c="M">47.0</td><td data-c="L">49.0</td><td data-c="XL">51.1</td><td data-c="XXL">53.1</td><td data-c="3XL">55.1</td></tr></tbody></table></div></div></div>
  <p class="sg-note"><b>Athletic fit, with four-way stretch.</b> Between sizes, size up.</p>
</div></div>
<script>
document.addEventListener('click', function(e){ var u = e.target.closest('[data-unit]'); if (!u) return;
  [].forEach.call(document.querySelectorAll('[data-unit]'), function(x){ x.setAttribute('aria-pressed', String(x === u)); });
  [].forEach.call(document.querySelectorAll('[data-unit-panel]'), function(p){ p.hidden = p.getAttribute('data-unit-panel') !== u.getAttribute('data-unit'); }); });
</script>
