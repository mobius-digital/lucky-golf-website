{%- comment -%}
  Structured data for Google. Organization + WebSite (with search) on the home
  page; Product (+ AggregateRating only at the review minimum, matching what the
  page shows) on products; Article on posts; BreadcrumbList on products,
  collections and posts. FAQPage comes from the FAQ section itself.
{%- endcomment -%}
{%- liquid
  assign min = settings.lg_review_min | default: 10
  assign org_logo = 'lg-mags-ink.webp' | file_url | prepend: 'https:'
  if settings.favicon != blank
    assign org_logo = settings.favicon | image_url: width: 512 | prepend: 'https:'
  endif
-%}
{%- if request.page_type == 'index' -%}
<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "Organization",
      "@id": {{ shop.url | append: '/#org' | json }},
      "name": {{ shop.name | json }},
      "url": {{ shop.url | json }},
      "logo": {{ org_logo | json }},
      "sameAs": [{{ settings.social_instagram_link | json }}, {{ settings.social_tiktok_link | json }}, {{ settings.social_youtube_link | json }}]
    },
    {
      "@type": "WebSite",
      "@id": {{ shop.url | append: '/#site' | json }},
      "name": {{ shop.name | json }},
      "url": {{ shop.url | json }},
      "publisher": { "@id": {{ shop.url | append: '/#org' | json }} },
      "potentialAction": {
        "@type": "SearchAction",
        "target": { "@type": "EntryPoint", "urlTemplate": "{{ shop.url }}{{ routes.search_url }}?q={search_term_string}" },
        "query-input": "required name=search_term_string"
      }
    }
  ]
}
</script>
{%- elsif request.page_type == 'product' -%}
{%- liquid
  assign rc = product.metafields.reviews.rating_count.value | default: 0
  assign rv = product.metafields.reviews.rating.value.rating
  assign v = product.selected_or_first_available_variant
-%}
<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "Product",
      "@id": {{ canonical_url | append: '#product' | json }},
      "name": {{ product.title | json }},
      "url": {{ canonical_url | json }},
      {%- if product.featured_image %}"image": [{% for m in product.images limit: 5 %}{{ m | image_url: width: 1200 | prepend: 'https:' | json }}{% unless forloop.last %},{% endunless %}{% endfor %}],{% endif %}
      "description": {{ product.description | strip_html | strip_newlines | truncate: 500 | json }},
      "brand": { "@type": "Brand", "name": {{ shop.name | json }} },
      {%- if v.sku != blank %}"sku": {{ v.sku | json }},{% endif %}
      {%- if v.barcode != blank %}"gtin": {{ v.barcode | json }},{% endif %}
      {%- if rc >= min and rv %}"aggregateRating": { "@type": "AggregateRating", "ratingValue": {{ rv | json }}, "reviewCount": {{ rc | json }} },{% endif %}
      "offers": [{% for x in product.variants %}{
        "@type": "Offer",
        "url": {{ canonical_url | append: '?variant=' | append: x.id | json }},
        {%- if x.sku != blank %}"sku": {{ x.sku | json }},{% endif %}
        "price": {{ x.price | divided_by: 100.0 | json }},
        "priceCurrency": {{ cart.currency.iso_code | json }},
        "itemCondition": "https://schema.org/NewCondition",
        "availability": "https://schema.org/{% if x.available %}InStock{% else %}OutOfStock{% endif %}",
        "seller": { "@type": "Organization", "name": {{ shop.name | json }} }
      }{% unless forloop.last %},{% endunless %}{% endfor %}]
    },
    {
      "@type": "BreadcrumbList",
      "itemListElement": [
        { "@type": "ListItem", "position": 1, "name": "Home", "item": {{ shop.url | json }} },
        {%- if collection %}{ "@type": "ListItem", "position": 2, "name": {{ collection.title | json }}, "item": {{ shop.url | append: collection.url | json }} },{% endif %}
        { "@type": "ListItem", "position": {% if collection %}3{% else %}2{% endif %}, "name": {{ product.title | json }}, "item": {{ canonical_url | json }} }
      ]
    }
  ]
}
</script>
{%- elsif request.page_type == 'collection' -%}
<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  "itemListElement": [
    { "@type": "ListItem", "position": 1, "name": "Home", "item": {{ shop.url | json }} },
    { "@type": "ListItem", "position": 2, "name": {{ collection.title | json }}, "item": {{ canonical_url | json }} }
  ]
}
</script>
{%- elsif request.page_type == 'article' -%}
<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "Article",
      "headline": {{ article.title | json }},
      "url": {{ canonical_url | json }},
      "datePublished": {{ article.published_at | date: '%Y-%m-%dT%H:%M:%S%z' | json }},
      "dateModified": {{ article.updated_at | date: '%Y-%m-%dT%H:%M:%S%z' | json }},
      {%- if article.image %}"image": {{ article.image | image_url: width: 1200 | prepend: 'https:' | json }},{% endif %}
      "author": { "@type": "Organization", "name": {{ shop.name | json }} },
      "publisher": { "@type": "Organization", "name": {{ shop.name | json }}, "logo": { "@type": "ImageObject", "url": {{ org_logo | json }} } },
      "mainEntityOfPage": {{ canonical_url | json }}
    },
    {
      "@type": "BreadcrumbList",
      "itemListElement": [
        { "@type": "ListItem", "position": 1, "name": "Home", "item": {{ shop.url | json }} },
        { "@type": "ListItem", "position": 2, "name": {{ blog.title | json }}, "item": {{ shop.url | append: blog.url | json }} },
        { "@type": "ListItem", "position": 3, "name": {{ article.title | json }}, "item": {{ canonical_url | json }} }
      ]
    }
  ]
}
</script>
{%- endif -%}
