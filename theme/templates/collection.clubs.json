    "faq": {
      "type": "lg-ap-faq",
      "settings": {
        "no_top": false,
        "eyebrow": "Still deciding",
        "heading": "Which one's mine?",
        "body": "If it's still a coin flip after this, write to us and a person answers.",
        "cols": "even"
      },
      "blocks": {
        "b1": {
          "type": "trust",
          "settings": {
            "icon": "rotate-ccw",
            "text": "Sixty days to decide on any club"
          }
        },
        "b2": {
          "type": "trust",
          "settings": {
            "icon": "truck",
            "text": "Ships in 1 to 2 business days"
          }
        },
        "b3": {
          "type": "trust",
          "settings": {
            "icon": "credit-card",
            "text": "Shop Pay splits it at checkout"
          }
        },
        "b4": {
          "type": "q",
          "settings": {
            "q": "Which wedge loft should I start with?",
            "a": "<p>Keep four to six degrees between your wedges and each one gets its own yardage. Tell us your pitching wedge loft and we'll do the math.</p>"
          }
        },
        "b5": {
          "type": "q",
          "settings": {
            "q": "K grind or S grind?",
            "a": "<p>The K is the one you set up square and trust from anywhere, in every loft. The S has a narrower sole, so it opens up clean when you like to lay the face open around the green.</p>"
          }
        },
        "b6": {
          "type": "q",
          "settings": {
            "q": "Blade or mallet?",
            "a": "<p>It comes down to the ones you miss. The blade feels planted and tells you exactly where you struck it. The mallet spreads its weight out, so the misses stay closer to your line.</p>"
          }
        },
        "b7": {
          "type": "q",
          "settings": {
            "q": "What does the hybrid replace?",
            "a": "<p>It slots in where a 3-iron or a 5-wood would go, and the panels above lay out both.</p>"
          }
        },
        "b8": {
          "type": "q",
          "settings": {
            "q": "What if it's not the one?",
            "a": "<p>Every club gets sixty days. Talk to us first: club returns need our OK and a few photos, and the club has to come back in brand-new condition.</p>"
          }
        }
      },
