    "faq": {
      "type": "lg-ap-faq",
      "settings": {
        "no_top": true,
        "eyebrow": "Before you add it",
        "heading": "Get the fit right",
        "body": "Quick answers, so nothing ends up on the wrong club.",
        "cols": "narrow"
      },
      "blocks": {
        "b1": {
          "type": "q",
          "settings": {
            "q": "Does a club come with a head cover?",
            "a": "<p>No. Our clubs ship without one, which is why the covers live here.</p>"
          }
        },
        "b2": {
          "type": "q",
          "settings": {
            "q": "Will the blade cover fit my putter?",
            "a": "<p>The blade cover's cut for a blade head and the mallet cover for a mallet. Match the shape of the head, not the brand on it.</p>"
          }
        },
        "b3": {
          "type": "q",
          "settings": {
            "q": "What size grip do I need?",
            "a": "<p>The clover grips come in Standard, Midsize and Jumbo, and the bigger ones cost a little more. If you know the size you play, pick that. If you don't, Standard is the safe call.</p>"
          }
        },
        "b4": {
          "type": "q",
          "settings": {
            "q": "Can I send gear back?",
            "a": "<p>Thirty days, unused. A grip that's been fitted to a club counts as used, so decide before it goes on the shaft.</p>"
          }
        }
      },
