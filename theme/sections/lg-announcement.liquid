{%- comment -%} The green bar above the header: short true lines, each a link. {%- endcomment -%}
{%- if section.blocks.size > 0 -%}
<div class="lg-tick"><div class="lg-tick-in">
  {%- for block in section.blocks -%}
    <a href="{{ block.settings.url | default: '#' }}" {{ block.shopify_attributes }}>{{ block.settings.text }}</a>
  {%- endfor -%}
  {%- if section.settings.show_country and localization.available_countries.size > 1 -%}
    {%- form 'localization', class: 'lg-loc' -%}
      <label for="lg-country">Delivery to</label>
      <select id="lg-country" name="country_code" onchange="this.form.submit()">
        {%- for c in localization.available_countries -%}<option value="{{ c.iso_code }}"{% if c.iso_code == localization.country.iso_code %} selected{% endif %}>{{ c.name }} ({{ c.currency.iso_code }})</option>{%- endfor -%}
      </select>
      <input type="hidden" name="return_to" value="{{ request.path }}">
    {%- endform -%}
  {%- endif -%}
</div></div>
{%- endif -%}

{% schema %}
{
  "name": "Announcement bar",
  "enabled_on": { "groups": ["header"] },
  "max_blocks": 4,
  "settings": [ { "type": "checkbox", "id": "show_country", "label": "Show the delivery country picker", "default": true } ],
  "blocks": [
    {
      "type": "line", "name": "Line",
      "settings": [
        { "type": "inline_richtext", "id": "text", "label": "Text (bold allowed)", "default": "<b>Sixty days</b> to prove us wrong" },
        { "type": "url", "id": "url", "label": "Link" }
      ]
    }
  ]
}
{% endschema %}
