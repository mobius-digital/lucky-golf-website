    {
      "type": "product_list",
      "id": "rating_products",
      "label": "Products whose live reviews fill [avg] and [count]",
      "limit": 20
    },
    {
      "type": "paragraph",
      "content": "A trust line with [avg] and [count] shows the live Judge.me average and total across those products."
    }
  ],
  "blocks": [
    {
      "type": "link",
      "name": "Link",
      "settings": [
        {
          "type": "text",
          "id": "text",
          "label": "Text"
        },
        {
          "type": "url",
          "id": "url",
          "label": "Link"
        }
      ]
    },
    {
      "type": "trust",
      "name": "Trust line",
      "settings": [
        {
          "type": "select",
          "id": "icon",
          "label": "Icon",
          "options": [
            {
              "value": "star",
              "label": "star"
            },
            {
              "value": "badge-check",
              "label": "badge-check"
            },
            {
              "value": "truck",
              "label": "truck"
            },
            {
              "value": "credit-card",
              "label": "credit-card"
            },
            {
              "value": "rotate-ccw",
              "label": "rotate-ccw"
            },
            {
              "value": "shield-check",
              "label": "shield-check"
            },
            {
              "value": "package",
              "label": "package"
            },
            {
              "value": "hammer",
              "label": "hammer"
            },
            {
              "value": "anvil",
              "label": "anvil"
            },
            {
              "value": "tag",
              "label": "tag"
            },
            {
              "value": "hand-coins",
              "label": "hand-coins"
            },
            {
              "value": "message-circle",
              "label": "message-circle"
            },
            {
              "value": "mail",
              "label": "mail"
            },
            {
              "value": "map-pin",
              "label": "map-pin"
            },
            {
              "value": "search",
              "label": "search"
            },
            {
              "value": "shopping-bag",
              "label": "shopping-bag"
            },
            {
              "value": "circle-help",
              "label": "circle-help"
            }
          ],
          "default": "truck"
        },
        {
          "type": "text",
          "id": "text",
          "label": "Text"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Keep browsing"
    }
  ]
}
{% endschema %}
