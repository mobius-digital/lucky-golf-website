{%- liquid
  assign s = section.settings
  assign pic = s.image
  if pic == blank and product
    assign mi = s.media_n | minus: 1
    assign pic = product.media[mi].preview_image
  endif
-%}
{%- capture copy -%}
<div>
  {%- if s.eyebrow != blank %}<p class="lg-eyebrow">{{ s.eyebrow }}</p>{% endif -%}
  {% render 'lg-h', text: s.heading, tag: 'h2', cls: 'lg-d2' %}
  {{ s.body | replace: '<p>', '<p class="lg-body">' }}
  {%- if s.btn_label != blank %}<a class="lg-btn-line" href="{{ s.btn_url }}">{{ s.btn_label }} <span aria-hidden="true">&rarr;</span></a>{% endif -%}
</div>
{%- endcapture -%}
{%- capture fig -%}<figure class="lg-frame{% if s.tall %} is-tall{% endif %}">{%- if pic != blank -%}{{ pic | image_url: width: 1400 | image_tag: loading: 'lazy', alt: '', widths: '600,900,1400', sizes: '(max-width: 749px) 100vw, 45vw' }}{%- else -%}<span class="lg-slot"><small>Photo</small>Add a close-up photo to the product</span>{%- endif -%}</figure>{%- endcapture -%}
{%- if s.tall -%}
<section class="lg-sec piece" style="padding-top:0"><div class="lg-wrap"><div class="lg-split">{{ copy }}{{ fig }}</div></div></section>
{%- else -%}
<section class="lg-sec" style="padding-top:0"><div class="lg-wrap lg-split">{{ copy }}{{ fig }}</div></section>
{%- endif -%}

{% schema %}
{
  "name": "Product story + photo",
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "The polo"
    },
    {
      "type": "inline_richtext",
      "id": "heading",
      "label": "Heading (italic = gold word)",
      "info": "Select a word and press Italic to make it the gold word."
    },
    {
      "type": "richtext",
      "id": "body",
      "label": "Text"
    },
    {
      "type": "text",
      "id": "btn_label",
      "label": "Button (outline)"
    },
    {
      "type": "url",
      "id": "btn_url",
      "label": "Button link"
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "Photo (empty = one of the product's own photos)"
    },
    {
      "type": "range",
      "id": "media_n",
      "label": "Which product photo (1 = first)",
      "min": 1,
      "max": 10,
      "step": 1,
      "default": 4
    },
    {
      "type": "checkbox",
      "id": "tall",
      "label": "Tall photo, wide text (polo)",
      "default": true
    }
  ],
  "presets": [
    {
      "name": "Product story + photo"
    }
  ]
}
{% endschema %}
