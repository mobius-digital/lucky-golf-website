{%- comment -%} editable: theme-editor settings first, club_page fallback {%- endcomment -%}
{%- assign c = product.metafields.custom.club_page.value -%}

{%- assign s = section.settings -%}
{%- if c.more.size > 0 -%}
<section class="lg-sec more" id="more"><div class="lg-wrap">
  <div class="hd"><div><p class="lg-eyebrow">{{ s.eyebrow }}</p><h2 class="lg-d2">{{ s.heading }}</h2></div>{% if s.link_label != blank %}<a class="lg-link" href="{{ s.link_url }}">{{ s.link_label }} <span>&rarr;</span></a>{% endif %}</div>
  <div class="lg-grid">
    {%- for m in c.more -%}{%- assign k = forloop.index -%}{%- assign kp = 'p_m' | append: k | append: '_product' -%}{%- assign kn = 'p_m' | append: k | append: '_name' -%}{%- assign kl = 'p_m' | append: k | append: '_line' -%}{%- assign mp = s[kp] | default: all_products[m[0]] -%}{%- assign m_n = s[kn] | default: m[1] -%}{%- assign m_l = s[kl] | default: m[2] -%}
      {%- if mp != blank -%}{% render 'lg-card', product: mp, name: m_n, line: m_l, cut: true, stars: false %}{%- endif -%}
    {%- endfor -%}
  </div>
</div></section>
{%- endif -%}

{% schema %}
{
  "name": "Club: more from the bag",
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "More from the bag"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Round out the bag"
    },
    {
      "type": "text",
      "id": "link_label",
      "label": "Link",
      "default": "See every club"
    },
    {
      "type": "url",
      "id": "link_url",
      "label": "Link URL"
    },
    {
      "type": "header",
      "content": "This club's words"
    },
    {
      "type": "paragraph",
      "content": "Leave a field empty to use the product's saved copy."
    },
    {
      "type": "product",
      "id": "p_m1_product",
      "label": "Card 1 product"
    },
    {
      "type": "text",
      "id": "p_m1_name",
      "label": "Card 1 name"
    },
    {
      "type": "text",
      "id": "p_m1_line",
      "label": "Card 1 line"
    },
    {
      "type": "product",
      "id": "p_m2_product",
      "label": "Card 2 product"
    },
    {
      "type": "text",
      "id": "p_m2_name",
      "label": "Card 2 name"
    },
    {
      "type": "text",
      "id": "p_m2_line",
      "label": "Card 2 line"
    },
    {
      "type": "product",
      "id": "p_m3_product",
      "label": "Card 3 product"
    },
    {
      "type": "text",
      "id": "p_m3_name",
      "label": "Card 3 name"
    },
    {
      "type": "text",
      "id": "p_m3_line",
      "label": "Card 3 line"
    },
    {
      "type": "product",
      "id": "p_m4_product",
      "label": "Card 4 product"
    },
    {
      "type": "text",
      "id": "p_m4_name",
      "label": "Card 4 name"
    },
    {
      "type": "text",
      "id": "p_m4_line",
      "label": "Card 4 line"
    }
  ]
}
{% endschema %}
