    { "type": "text", "id": "list_deal", "label": "List: deal line", "default": "Free towel and divot tool with any club. $50 off two clubs. $100 off three or more." },
    { "type": "text", "id": "list_lede", "label": "List: line", "default": "Two days before everyone else. First pick of every loft." },
    { "type": "text", "id": "live_eyebrow", "label": "Black Friday: eyebrow", "default": "Black Friday" },
    { "type": "text", "id": "live_heading", "label": "Black Friday: heading", "default": "The more you bag, the less you pay" },
    { "type": "text", "id": "live_deal", "label": "Black Friday: deal line", "default": "Free towel and divot tool with any club. $50 off two clubs. $100 off three or more." },
    { "type": "text", "id": "live_lede", "label": "Black Friday: line", "default": "No code. The price drops in your bag." },
