    { "type": "text", "id": "clock_label", "label": "Countdown label", "default": "Deal ends in" },
    { "type": "text", "id": "mail_eyebrow", "label": "Mail: eyebrow", "default": "Postcard early access" },
    { "type": "text", "id": "mail_heading", "label": "Mail: heading", "default": "Black Friday came by mail" },
    { "type": "text", "id": "mail_deal", "label": "Mail: deal line", "default": "Free towel and divot tool with any club. $50 off two clubs. $100 off three or more." },
