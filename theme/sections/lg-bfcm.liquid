    { "type": "text", "id": "over_lede", "label": "After: second line" },
    { "type": "text", "id": "over_btn", "label": "After: button", "default": "See the clubs" },
    { "type": "text", "id": "trust_days", "label": "Returns line", "default": "Sixty days to prove us wrong" },
    { "type": "header", "content": "The math" },
    { "type": "text", "id": "math_title", "label": "Heading", "default": "Do the math" },
    { "type": "text", "id": "math_line", "label": "Line", "default": "Mix any clubs you want. Every club counts toward the next rung." },
