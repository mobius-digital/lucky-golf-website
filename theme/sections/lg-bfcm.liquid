{%- comment -%}
  The Black Friday / Cyber Monday 2026 page (/pages/black-friday, template page.black-friday).
  ONE stable URL for every phase, so the PostPilot QR printed on Oct 26 never breaks:
    mail  (until Nov 23)  direct mail early access, code LUCKYMAIL
    list  (Nov 24 to 25)  email/SMS early access
    live  (Nov 26 to 29)  Black Friday for everyone, automatic
    cm    (Nov 30)        Cyber Monday, last day
    over  (Dec 1 on)      deal over, clubs still here
  The phase switches itself in the browser on Central time (data-bf-*); the dates are settings below.
  The money is the Lucky Discounts app's "Lucky club ladder" function (repo Mobius Digital Tools/lucky-discounts):
  products tagged "club" count, $50 off 2, $100 off 3+. LUCKYMAIL is a code discount on that function.
  Arriving with ?utm_source=postpilot or ?code=X applies the code for them (GET /discount/CODE).
  Research and the plan behind this page: claude.ai artifact (BFCM page research, 2026-10-26).
{%- endcomment -%}
{%- liquid
  assign s = section.settings
  assign hero = s.hero_image | default: images['lg-carver-sets-hero.jpg']
  assign ship = settings.lg_free_shipping | default: 195
-%}
<div class="bf-page" data-bf-page data-phase="mail">

<section class="bf-hero">
  <div class="bf-hero-ph">{%- if hero != blank -%}{{ hero | image_url: width: 2400 | image_tag: alt: s.hero_alt, loading: 'eager', fetchpriority: 'high', widths: '750,1200,1600,2000,2400', sizes: '100vw' }}{%- endif -%}</div>
  <div class="lg-wrap bf-hero-in">
    {%- for ph in (1..5) -%}
      {%- case ph -%}
        {%- when 1 -%}{%- assign k = 'mail' -%}
        {%- when 2 -%}{%- assign k = 'list' -%}
        {%- when 3 -%}{%- assign k = 'live' -%}
        {%- when 4 -%}{%- assign k = 'cm' -%}
        {%- when 5 -%}{%- assign k = 'over' -%}
      {%- endcase -%}
      {%- assign h_key = k | append: '_heading' -%}{%- assign d_key = k | append: '_deal' -%}{%- assign l_key = k | append: '_lede' -%}{%- assign e_key = k | append: '_eyebrow' -%}
      <div class="bf-ph" data-bf-show="{{ k }}"{% unless k == 'mail' %} hidden{% endunless %}>
        {%- if s[e_key] != blank %}<p class="bf-eye">{{ s[e_key] }}</p>{% endif -%}
        <{% if k == 'mail' %}h1{% else %}h2{% endif %} class="bf-h1">{{ s[h_key] }}</{% if k == 'mail' %}h1{% else %}h2{% endif %}>
        {%- if s[d_key] != blank %}<p class="bf-deal">{{ s[d_key] }}</p>{% endif -%}
        {%- if s[l_key] != blank %}<p class="bf-lede">{{ s[l_key] }}</p>{% endif -%}
      </div>
    {%- endfor -%}

    <div class="bf-code" data-bf-show="mail list" data-bf-code hidden>
      <span class="bf-code-lbl" data-code-off>Code at checkout</span>
      <span class="bf-code-lbl" data-code-on hidden>Already in your bag</span>
      <b data-code-text>{{ s.mail_code }}</b>
    </div>

    <div class="bf-go" data-bf-show="mail list live cm">
      <a class="lg-btn" href="#clubs">{{ s.hero_btn }}</a>
      <span class="bf-clock" data-bf-clock><span>{{ s.clock_label }}</span> <b data-d>0</b>d <b data-h>00</b>h <b data-m>00</b>m</span>
    </div>
    <div class="bf-go" data-bf-show="over" hidden><a class="lg-btn" href="#clubs">{{ s.over_btn }}</a></div>
  </div>
</section>

<ul class="bf-strip">
  <li>{% render 'lg-icon', name: 'truck' %}Free shipping on ${{ ship }} and up</li>
  <li>{% render 'lg-icon', name: 'rotate-ccw' %}{{ s.trust_days }}</li>
  <li>{% render 'lg-icon', name: 'star' %}{{ s.trust_ships }}</li>
</ul>

<section class="lg-wrap bf-sec" id="deal" data-bf-show="mail list live cm" aria-labelledby="bf-deal-h">
  <h2 class="bf-h" id="bf-deal-h">{{ s.ladder_title }}</h2>
  <p class="bf-l">{{ s.ladder_line }}</p>
  <ol class="bf-ladder">
    <li class="bf-rung">
      <span class="bf-rung-n">1 club</span>
      <b class="bf-rung-v">{{ s.r1_value }}</b>
      <span class="bf-rung-s">{{ s.r1_small }}</span>
    </li>
    <li class="bf-rung">
      <span class="bf-rung-n">2 clubs</span>
      <b class="bf-rung-v">$50 off</b>
      <span class="bf-rung-s">{{ s.r2_small }}</span>
    </li>
    <li class="bf-rung is-best">
      <i class="bf-rung-tag">{{ s.best }}</i>
      <span class="bf-rung-n">3 or more</span>
      <b class="bf-rung-v">$100 off</b>
      <span class="bf-rung-s">{{ s.r3_small }}</span>
    </li>
  </ol>
  {%- if s.example != blank %}<p class="bf-ex">{{ s.example }}</p>{% endif -%}
</section>

<section class="lg-wrap bf-sec" id="clubs" aria-labelledby="bf-clubs-h">
  <h2 class="bf-h" id="bf-clubs-h">{{ s.clubs_title }}</h2>
  <p class="bf-l" data-bf-show="mail list live cm">{{ s.clubs_line }}</p>
  <div class="bf-cards">
    {%- for block in section.blocks -%}{%- assign b = block.settings -%}
      {%- if b.product != blank -%}
      <div class="bf-card" {{ block.shopify_attributes }}>{% render 'lg-card', product: b.product, name: b.name, line: b.line, finish: b.finish, image: b.image, cut: true, stars: true %}</div>
      {%- endif -%}
    {%- endfor -%}
  </div>
</section>

<section class="lg-wrap bf-sec bf-faq" id="questions" aria-labelledby="bf-q-h">
  <h2 class="bf-h" id="bf-q-h">{{ s.faq_title }}</h2>
  <div class="lg-faq">
    {%- for i in (1..8) -%}
      {%- assign qk = 'q' | append: i -%}{%- assign ak = 'a' | append: i -%}
      {%- if s[qk] != blank -%}
      <details class="lg-fq"><summary>{{ s[qk] }}</summary><div class="lg-fq-a"><p>{{ s[ak] | replace: '[ship]', ship }}</p></div></details>
      {%- endif -%}
    {%- endfor -%}
  </div>
</section>

<section class="bf-sign">
  <p class="bf-sign-t">It's better to be lucky.</p>
  <p class="bf-l">{{ s.sign_line }}</p>
  <a class="lg-btn" href="#clubs">{{ s.hero_btn }}</a>
</section>
</div>

<script>
window.LG_BF = {
  phases: [
    ['list', {{ s.list_start | json }}],
    ['live', {{ s.live_start | json }}],
    ['cm', {{ s.cm_start | json }}],
    ['over', {{ s.end | json }}]
  ],
  end: {{ s.end | json }},
  codes: { mail: {{ s.mail_code | json }}, list: {{ s.list_code | json }} },
  autoSources: {{ s.auto_sources | json }}
};
</script>
{{ 'lg-bfcm.css' | asset_url | stylesheet_tag }}
<script src="{{ 'lg-bfcm.js' | asset_url }}" defer></script>

{% schema %}
{
  "name": "Black Friday page",
  "tag": "section",
  "class": "lg-scope",
  "settings": [
    { "type": "paragraph", "content": "One page for every phase. Dates are Central time, written like 2026-11-24T00:00:00-06:00. The discount itself is the Lucky Discounts app (Discounts in admin)." },
    { "type": "header", "content": "Dates" },
    { "type": "text", "id": "list_start", "label": "List early access starts", "default": "2026-11-24T00:00:00-06:00" },
    { "type": "text", "id": "live_start", "label": "Black Friday for everyone starts", "default": "2026-11-26T00:00:00-06:00" },
    { "type": "text", "id": "cm_start", "label": "Cyber Monday starts", "default": "2026-11-30T00:00:00-06:00" },
