    { "type": "text", "id": "set_btn", "label": "Set button", "default": "Put the set in my bag" },
    { "type": "header", "content": "Build your own" },
    { "type": "text", "id": "build_title", "label": "Heading", "default": "Build your own" },
    { "type": "text", "id": "build_line", "label": "Line", "default": "Tap to add. The total at the bottom keeps up with you." },
    { "type": "text", "id": "bar_btn", "label": "Bottom bar button", "default": "Put them in my bag" },
    { "type": "header", "content": "Questions" },
    { "type": "text", "id": "faq_title", "label": "Heading", "default": "Questions" },
