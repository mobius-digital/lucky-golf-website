{%- comment -%}
  The Black Friday / Cyber Monday 2026 page (/pages/black-friday, template page.black-friday).
  ONE stable URL for every phase, so the PostPilot QR printed in October never breaks:
    mail  (until Nov 23)  direct mail early access, code LUCKYMAIL
    list  (Nov 24 to 25)  email/SMS early access
    live  (Nov 26 to 29)  Black Friday for everyone, automatic
    cm    (Nov 30)        Cyber Monday, last day
    over  (Dec 1 on)      order by Christmas: deal over, clubs still here
  Round 4 (2026-10-27, Cole: Vice's clean frame, Lucky's flair in the cards): heading, one line, a row of buyable cards,
  repeat. Hero = the offer + the ladder. Deals row = highlight cards rendered from the ad build (black ground, foil
  sticker, portrait on phones, landscape on desktop). Wedges row and Putters row = club cards with loft chips that fill
  a tray; the bar at the bottom is the receipt. Proof line + three real reviews, retired polos, five questions, the list.
  The money is the Lucky Discounts app's "Lucky club ladder" (Mobius Digital Tools/lucky-discounts): products tagged
  "club" count, $50 off 2, $100 off 3+. Gift: any club on LUCKYMAIL, 2+ clubs from Nov 24 (one set per order).
  Arriving with ?utm_source=postpilot or ?code=X applies the code (GET /discount/CODE). Preview a phase: ?bf_phase=live
{%- endcomment -%}
{%- liquid
  assign s = section.settings
  assign ship = settings.lg_free_shipping | default: 195
  assign carver = all_products['lucky-golf-lgw02-gold']
  assign rc = carver.metafields.reviews.rating_count.value | default: 0
  assign rv = carver.metafields.reviews.rating.value.rating
  assign jd = carver.metafields.judgeme.review_widget_data.value
  assign hero2400 = 'lg-bf-hero-2400.jpg' | asset_url
  assign hero1200 = 'lg-bf-hero-1200.jpg' | asset_url
  assign phase_keys = "mail,list,live,cm,over" | split: ","
-%}
<div class="bf-page" data-bf-page data-phase="mail">

<section class="bf-hero">
  <div class="bf-hero-ph">
    {%- if s.hero_image != blank -%}
      {{ s.hero_image | image_url: width: 2400 | image_tag: alt: s.hero_alt, loading: 'eager', fetchpriority: 'high', widths: '750,1200,1600,2400', sizes: '100vw' }}
    {%- else -%}
      <img src="{{ hero1200 }}" srcset="{{ hero1200 }} 1200w, {{ hero2400 }} 2400w" sizes="100vw" alt="{{ s.hero_alt | escape }}" loading="eager" fetchpriority="high" width="2160" height="2700">
    {%- endif -%}
  </div>
  <div class="lg-wrap bf-hero-in">
    {%- for k in phase_keys -%}
      {%- assign e_key = k | append: '_eyebrow' -%}{%- assign h_key = k | append: '_heading' -%}{%- assign h2_key = k | append: '_heading2' -%}{%- assign d_key = k | append: '_deal' -%}
      <div class="bf-ph" data-bf-show="{{ k }}"{% unless k == 'mail' %} hidden{% endunless %}>
        {%- if s[e_key] != blank %}<p class="bf-stamp">{{ s[e_key] }}</p>{% endif -%}
        <{% if k == 'mail' %}h1{% else %}h2{% endif %} class="bf-h1"><span class="bf-big1">{{ s[h_key] }}</span><span class="bf-big">{{ s[h2_key] }}</span></{% if k == 'mail' %}h1{% else %}h2{% endif %}>
        {%- if s.gifts_gone and k != 'over' -%}<p class="bf-deal">{{ s.gone_deal }}</p>
        {%- elsif s[d_key] != blank -%}<p class="bf-deal">{{ s[d_key] }}</p>{%- endif -%}
      </div>
    {%- endfor -%}

    <ol class="bf-lad" data-bf-show="mail list live cm" aria-label="The ladder">
      <li><span data-lad-1>{{ s.lad_1 }}</span></li>
      <li><span>{{ s.lad_2 }}</span></li>
      <li><span>{{ s.lad_3 }}</span></li>
    </ol>

    <div class="bf-ticket" data-bf-show="mail list" data-bf-code hidden>
      <span class="bf-ticket-l"><small data-code-off>Code at checkout</small><small data-code-on hidden>Already in your bag</small><b data-code-text>{{ s.mail_code }}</b></span>
      <span class="bf-ticket-r" aria-hidden="true"><svg viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><path d="M20 6 9 17l-5-5"/></svg></span>
    </div>

    <div class="bf-go" data-bf-show="mail list live cm">
      <a class="lg-btn" href="#deals">{{ s.hero_btn }}</a>
      <a class="bf-go-2" href="#wedges">{{ s.hero_btn2 }}</a>
    </div>
    <p class="bf-when" data-bf-show="mail list live cm">
      <span data-bf-ends>{{ s.ends_line }}</span>
      <span class="bf-clock" data-bf-clock hidden><span>{{ s.clock_label }}</span> <b data-d>0</b>d <b data-h>00</b>h <b data-m>00</b>m</span>
    </p>
    <div class="bf-go" data-bf-show="over" hidden><a class="lg-btn" href="#wedges">{{ s.over_btn }}</a></div>
  </div>
</section>

{%- assign cards = section.blocks | where: "type", "highlight" -%}
{%- if cards.size > 0 -%}
<section class="lg-wrap bf-sec" id="deals" data-bf-show="mail list live cm" aria-labelledby="bf-deals-h">
  <div class="bf-hd">
    <h2 class="bf-h" id="bf-deals-h"><span data-bf-show="mail list">{{ s.deals_title_early }}</span><span data-bf-show="live" hidden>{{ s.deals_title }}</span><span data-bf-show="cm" hidden>{{ s.deals_title_cm }}</span></h2>
    <p class="bf-l">{{ s.deals_line }}</p>
  </div>
  <div class="bf-cards" data-cards>
    {%- for block in cards -%}{%- assign b = block.settings -%}
      {%- assign im_m = 'lg-bf-card-' | append: b.key | append: '-m.jpg' | asset_url -%}
      {%- assign im_d = 'lg-bf-card-' | append: b.key | append: '-d.jpg' | asset_url -%}
      {%- assign show = b.phases | default: 'mail list live cm' -%}
      {%- assign href = b.link | default: '#wedges' -%}
      <article class="bf-card" data-card data-pieces="{{ b.pieces | escape }}" data-bf-show="{{ show }}" {{ block.shopify_attributes }}>
        <a class="bf-card-ph" href="{{ href }}" aria-hidden="true" tabindex="-1">
          <picture>
            <source media="(min-width:750px)" srcset="{{ im_d }}">
            <img src="{{ im_m }}" alt="" loading="{% if forloop.index < 3 %}eager{% else %}lazy{% endif %}" width="942" height="1386">
          </picture>
          {%- if b.chip != blank %}<i class="bf-st is-gold">{{ b.chip }}</i>{% endif -%}
          <i class="bf-st is-low" data-card-low hidden>Running low</i>
        </a>
        <div class="bf-card-bd">
          <h3><a href="{{ href }}">{{ b.name }}</a></h3>
          <p>{{ b.line }}</p>
          <ul class="bf-card-pieces" data-card-pieces hidden></ul>
          <div class="bf-card-ft">
            <p class="bf-card-pr" data-card-price>{% if b.price != blank %}<b>{{ b.price }}</b>{% endif %}</p>
            {%- if b.pieces != blank -%}
              <button type="button" class="lg-btn" data-card-add>{{ b.btn | default: s.set_btn }}</button>
            {%- else -%}
              <a class="lg-btn{% if b.btn_line %} lg-btn-line{% endif %}" href="{{ href }}">{{ b.btn | default: 'See it' }}</a>
            {%- endif -%}
          </div>
        </div>
      </article>
    {%- endfor -%}
  </div>
</section>
{%- endif -%}

<section class="lg-wrap bf-sec" id="wedges" aria-labelledby="bf-wedges-h">
  <div class="bf-hd">
    <h2 class="bf-h" id="bf-wedges-h">{{ s.wedges_title }}</h2>
    <p class="bf-l">{{ s.wedges_line }}</p>
    <div class="bf-hands" role="group" aria-label="Hand" data-hands></div>
  </div>
  <div class="bf-pcs" data-rows="wedges"></div>
</section>

<section class="lg-wrap bf-sec" id="putters" aria-labelledby="bf-putters-h">
  <div class="bf-hd">
    <h2 class="bf-h" id="bf-putters-h">{{ s.putters_title }}</h2>
    <p class="bf-l"><span data-bf-show="mail">{{ s.putters_line_mail }}</span><span data-bf-show="list live cm over" hidden>{{ s.putters_line }}</span></p>
  </div>
  <div class="bf-pcs is-3" data-rows="putters"></div>
</section>

<section class="bf-proof" aria-label="Why Lucky">
  <div class="lg-wrap">
    <ul class="bf-trust">
      {%- if rc >= 10 and rv %}<li><b>{{ rv | round: 1 }}</b><span>stars from {{ rc }} golfers</span></li>{% endif -%}
      <li><b>{{ s.trust_2_big }}</b><span>{{ s.trust_2 }}</span></li>
      <li><b>{{ s.trust_3_big }}</b><span>{{ s.trust_3 }}</span></li>
    </ul>
    {%- if jd.reviews.size > 0 -%}
    <ul class="bf-revs">
      {%- assign shown = 0 -%}
      {%- for r in jd.reviews -%}
        {%- if r.rating >= 5 and r.body.size > 40 and shown < 3 -%}
          {%- assign shown = shown | plus: 1 -%}
          <li><p>"{{ r.body | strip | truncate: 150 }}"</p><small>{{ r.reviewer_name | default: 'A golfer' }}{% if r.verified_buyer %} · Verified{% endif %}</small></li>
        {%- endif -%}
      {%- endfor -%}
    </ul>
    {%- endif -%}
  </div>
</section>

{%- assign polos = section.blocks | where: "type", "polo" -%}
{%- if polos.size > 0 -%}
<section class="lg-wrap bf-sec" id="polos" aria-labelledby="bf-polos-h">
  <div class="bf-hd"><h2 class="bf-h" id="bf-polos-h">{{ s.polo_title }}</h2><p class="bf-l">{{ s.polo_line }}</p></div>
  <div class="bf-polos">
    {%- for block in polos -%}{%- assign p = block.settings.product -%}{%- if p != blank -%}
    <article class="bf-polo" {{ block.shopify_attributes }}>
      <a class="bf-polo-ph" href="{{ p.url }}"><img src="{{ p.featured_image | image_url: width: 600 }}" alt="{{ p.title | escape }}" loading="lazy"></a>
      <h3><a href="{{ p.url }}">{{ p.title | remove: ' Classic Polo' | remove: ' Blade Polo' }}</a> <span><b>${{ s.polo_price }}</b> <s>{{ p.price | money_without_trailing_zeros }}</s></span></h3>
      <div class="bf-chips">
        {%- for v in p.variants -%}<button type="button" class="bf-chip bf-chip-sm" data-polo="{{ v.id }}"{% unless v.available %} disabled aria-disabled="true"{% endunless %}>{{ v.title }}</button>{%- endfor -%}
      </div>
    </article>
    {%- endif -%}{%- endfor -%}
  </div>
</section>
{%- endif -%}

<section class="lg-wrap bf-sec bf-faq" id="questions" aria-labelledby="bf-q-h">
  <div class="bf-hd"><h2 class="bf-h" id="bf-q-h">{{ s.faq_title }}</h2></div>
  <div class="lg-faq">
    {%- for i in (1..5) -%}
      {%- assign qk = 'q' | append: i -%}{%- assign ak = 'a' | append: i -%}
      {%- if s[qk] != blank -%}
      <details class="lg-fq"><summary>{{ s[qk] }}</summary><div class="lg-fq-a"><p>{% if i == 4 and s.gifts_gone %}{{ s.a4_gone }}{% else %}{{ s[ak] | replace: '[ship]', ship | replace: '[std]', s.xmas_std }}{% endif %}</p></div></details>
      {%- endif -%}
    {%- endfor -%}
  </div>
</section>

<section class="bf-list" id="list" data-bf-list hidden aria-labelledby="bf-list-h">
  <div class="lg-wrap bf-list-in">
    <div>
      <p class="bf-stamp">{{ s.list_stamp }}</p>
      <h2 class="bf-h" id="bf-list-h"><span data-bf-show="mail">{{ s.list_title_before }}</span><span data-bf-show="list live cm over" hidden>{{ s.list_title_after }}</span></h2>
      <p class="bf-l"><span data-bf-show="mail">{{ s.list_line_before }}</span><span data-bf-show="list live cm over" hidden>{{ s.list_line_after }}</span></p>
    </div>
    <form class="bf-form" data-bf-form novalidate>
      <label class="sr" for="bf-email">Email</label>
      <input id="bf-email" name="email" type="email" inputmode="email" autocomplete="email" placeholder="you@email.com" required>
      <button type="submit" class="lg-btn">{{ s.list_btn }}</button>
      <p class="bf-form-msg" data-bf-form-msg hidden></p>
    </form>
  </div>
</section>

<div class="bf-bar" data-bf-bar hidden>
  <div class="bf-bar-in">
    <div class="bf-bar-txt"><b data-bar-total></b><span data-bar-sub></span></div>
    <button type="button" class="lg-btn" data-bar-add>{{ s.bar_btn }}</button>
  </div>
  <p class="bf-bar-nudge" data-bar-nudge hidden></p>
</div>
</div>

<script>
window.LG_BF = {
  phases: [['list', {{ s.list_start | json }}], ['live', {{ s.live_start | json }}], ['cm', {{ s.cm_start | json }}], ['over', {{ s.end | json }}]],
  end: {{ s.end | json }},
  clockHours: {{ s.clock_hours | default: 48 }},
  codes: { mail: {{ s.mail_code | json }}, list: {{ s.list_code | json }} },
  autoSources: {{ s.auto_sources | json }},
  giftsGone: {{ s.gifts_gone | json }},
  ship: {{ ship | times: 100 }},
  lowAt: {{ s.low_at | default: 60 }},
  say: { bar: {{ s.bar_btn | json }}, lad1Mail: {{ s.lad_1_mail | json }} },
  klaviyo: { key: {{ settings.lg_klaviyo_public_key | json }}, list: {{ s.klaviyo_list | default: settings.lg_klaviyo_list | json }} },
  clubs: [
    {%- for block in section.blocks -%}{%- if block.type == 'club' or block.type == 'drop' -%}{%- assign b = block.settings -%}{%- assign p = b.product -%}
    {%- if p != blank -%}
    {%- assign cut = p.metafields.custom.cutout.value -%}
    {%- if block.type == 'drop' %}{% assign isdrop = true %}{% else %}{% assign isdrop = false %}{% endif -%}
    { key: {{ b.key | json }}, drop: {{ isdrop }}, group: {{ b.group | default: 'putters' | json }}, name: {{ b.name | default: p.title | json }}, line: {{ b.line | json }}, finish: {{ b.finish | json }}, url: {{ p.url | json }},
      img: {% if b.image != blank %}{{ b.image | image_url: width: 800 | json }}{% elsif cut != blank %}{{ cut | image_url: width: 800 | json }}{% else %}{{ p.featured_image | image_url: width: 800 | json }}{% endif %},
      opts: {{ p.options | json }},
      variants: [{%- for v in p.variants -%}{ id: {{ v.id }}, o: {{ v.options | json }}, a: {{ v.available }}, q: {{ v.inventory_quantity | default: 0 }}, p: {{ v.price }} }{% unless forloop.last %},{% endunless %}{%- endfor -%}] },
    {%- endif -%}
    {%- endif -%}{%- endfor -%}
    null
  ].filter(Boolean)
};
</script>
{{ 'lg-bfcm.css' | asset_url | stylesheet_tag }}
<script src="{{ 'lg-bfcm.js' | asset_url }}" defer></script>

{% schema %}
{
  "name": "Black Friday page",
  "tag": "section",
  "class": "lg-scope",
  "settings": [
    { "type": "paragraph", "content": "One page for every phase. Dates are Central time, written like 2026-11-24T00:00:00-06:00. The discount itself is the Lucky Discounts app (Discounts in admin)." },
    { "type": "header", "content": "Dates" },
    { "type": "text", "id": "list_start", "label": "List early access starts", "default": "2026-11-24T00:00:00-06:00" },
    { "type": "text", "id": "live_start", "label": "Black Friday for everyone starts", "default": "2026-11-26T00:00:00-06:00" },
    { "type": "text", "id": "cm_start", "label": "Cyber Monday starts", "default": "2026-11-30T00:00:00-06:00" },
    { "type": "text", "id": "end", "label": "Deal ends", "default": "2026-12-01T00:00:00-06:00" },
    { "type": "range", "id": "clock_hours", "label": "Show the countdown only inside the last (hours)", "min": 0, "max": 120, "step": 12, "default": 48 },
    { "type": "text", "id": "xmas_std", "label": "Order by (standard) for Christmas", "default": "Dec 13" },
    { "type": "header", "content": "Codes and gifts" },
    { "type": "text", "id": "mail_code", "label": "Direct mail code", "default": "LUCKYMAIL" },
    { "type": "text", "id": "list_code", "label": "List early access code", "info": "Empty: the list phase shows the mail code." },
    { "type": "text", "id": "auto_sources", "label": "utm_source values that get the code applied for them", "default": "postpilot" },
    { "type": "checkbox", "id": "gifts_gone", "label": "Towels and divot tools are gone", "default": false, "info": "Tick when stock hits zero: gift copy comes off every phase." },
    { "type": "text", "id": "gone_deal", "label": "Deal line once gifts are gone", "default": "Gifts are gone. $50 off 2 clubs, $100 off 3 or more still on." },
    { "type": "range", "id": "low_at", "label": "Show Running low under this many units", "min": 10, "max": 200, "step": 10, "default": 60 },
    { "type": "header", "content": "Hero" },
    { "type": "image_picker", "id": "hero_image", "label": "Hero photo", "info": "Empty: the night-shoot Carver (lg-bf-hero-2400.jpg in assets)." },
    { "type": "text", "id": "hero_alt", "label": "Hero photo alt text", "default": "Gold Carver 02 wedge on wet pavement at night" },
    { "type": "text", "id": "hero_btn", "label": "Hero button", "default": "See the deals" },
    { "type": "text", "id": "hero_btn2", "label": "Hero second link", "default": "Or build your own" },
    { "type": "text", "id": "ends_line", "label": "Ends line (before the countdown shows)", "default": "No code. Ends Monday at midnight." },
    { "type": "text", "id": "clock_label", "label": "Countdown label", "default": "Ends in" },
    { "type": "text", "id": "lad_1", "label": "Ladder: 1 club", "default": "One club: already under their sale price." },
    { "type": "text", "id": "lad_1_mail", "label": "Ladder: 1 club, postcard visitors", "default": "One club: towel and divot tool on us." },
    { "type": "text", "id": "lad_2", "label": "Ladder: 2 clubs", "default": "Two: $50 off, towel and divot tool on us." },
    { "type": "text", "id": "lad_3", "label": "Ladder: 3 or more", "default": "Three or more: $100 off, gifts, ships free." },
    { "type": "text", "id": "mail_eyebrow", "label": "Mail: stamp", "default": "Postcard early access" },
    { "type": "text", "id": "mail_heading", "label": "Mail: line one", "default": "Three clubs." },
    { "type": "text", "id": "mail_heading2", "label": "Mail: big line", "default": "$100 off." },
    { "type": "text", "id": "mail_deal", "label": "Mail: deal line", "default": "You're in a month early. The code's already in your bag." },
    { "type": "text", "id": "list_eyebrow", "label": "List: stamp", "default": "Early access · Two days before everyone" },
    { "type": "text", "id": "list_heading", "label": "List: line one", "default": "Three clubs." },
    { "type": "text", "id": "list_heading2", "label": "List: big line", "default": "$100 off." },
    { "type": "text", "id": "list_deal", "label": "List: deal line", "default": "First pick of every loft, and the black Eclipse." },
    { "type": "text", "id": "live_eyebrow", "label": "Black Friday: stamp", "default": "Black Friday · Nov 26 to 30" },
    { "type": "text", "id": "live_heading", "label": "Black Friday: line one", "default": "Three clubs." },
    { "type": "text", "id": "live_heading2", "label": "Black Friday: big line", "default": "$100 off." },
    { "type": "text", "id": "live_deal", "label": "Black Friday: deal line", "default": "Towel and divot tool free at two clubs." },
    { "type": "text", "id": "cm_eyebrow", "label": "Cyber Monday: stamp", "default": "Cyber Monday · Last day" },
    { "type": "text", "id": "cm_heading", "label": "Cyber Monday: line one", "default": "Last call." },
    { "type": "text", "id": "cm_heading2", "label": "Cyber Monday: big line", "default": "$100 off." },
    { "type": "text", "id": "cm_deal", "label": "Cyber Monday: deal line", "default": "Same deal, same gifts. Gone at midnight." },
    { "type": "text", "id": "over_eyebrow", "label": "After: stamp", "default": "Order by Christmas" },
    { "type": "text", "id": "over_heading", "label": "After: line one", "default": "The set" },
    { "type": "text", "id": "over_heading2", "label": "After: big line", "default": "under the tree." },
    { "type": "text", "id": "over_deal", "label": "After: line", "default": "Black Friday is over. The clubs still ship in time." },
    { "type": "text", "id": "over_btn", "label": "After: button", "default": "See the clubs" },
    { "type": "header", "content": "Deals row" },
    { "type": "text", "id": "deals_title_early", "label": "Heading, early access", "default": "Early access deals" },
    { "type": "text", "id": "deals_title", "label": "Heading, Black Friday", "default": "Black Friday deals" },
    { "type": "text", "id": "deals_title_cm", "label": "Heading, Cyber Monday", "default": "Cyber Monday deals" },
    { "type": "text", "id": "deals_line", "label": "Line", "default": "Three clubs, one tap." },
    { "type": "text", "id": "set_btn", "label": "Set button", "default": "Put the set in my bag" },
    { "type": "header", "content": "Wedges row" },
    { "type": "text", "id": "wedges_title", "label": "Heading", "default": "Wedges" },
    { "type": "text", "id": "wedges_line", "label": "Line", "default": "Tap a loft. $100 comes off at three." },
    { "type": "header", "content": "Putters row" },
    { "type": "text", "id": "putters_title", "label": "Heading", "default": "Putters and the Stryker" },
    { "type": "text", "id": "putters_line_mail", "label": "Line before Nov 24", "default": "They count as a club. The black Eclipse lands Nov 24." },
    { "type": "text", "id": "putters_line", "label": "Line from Nov 24", "default": "They count as a club." },
    { "type": "text", "id": "bar_btn", "label": "Bar button", "default": "Put them in my bag" },
    { "type": "header", "content": "Proof" },
    { "type": "text", "id": "trust_2_big", "label": "Trust 2, big", "default": "1020" },
    { "type": "text", "id": "trust_2", "label": "Trust 2, line", "default": "forged carbon steel, not cast" },
    { "type": "text", "id": "trust_3_big", "label": "Trust 3, big", "default": "60" },
    { "type": "text", "id": "trust_3", "label": "Trust 3, line", "default": "days to prove us wrong" },
    { "type": "header", "content": "Retired polos" },
    { "type": "text", "id": "polo_title", "label": "Heading", "default": "Last run" },
    { "type": "text", "id": "polo_line", "label": "Line", "default": "$39 while the sizes last." },
    { "type": "number", "id": "polo_price", "label": "Polo price shown", "default": 39, "info": "The products themselves must be repriced in admin before the page goes live, or the bag charges full price." },
    { "type": "header", "content": "Questions" },
