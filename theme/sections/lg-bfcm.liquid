{%- comment -%}
  The Black Friday / Cyber Monday 2026 page (/pages/black-friday, template page.black-friday).
  ONE stable URL for every phase, so the PostPilot QR printed in October never breaks:
    mail  (until Nov 23)  direct mail early access, code LUCKYMAIL
    list  (Nov 24 to 25)  email/SMS early access
    live  (Nov 26 to 29)  Black Friday for everyone, automatic
    cm    (Nov 30)        Cyber Monday, last day
    over  (Dec 1 on)      order by Christmas: deal over, clubs still here
  Round 5 (2026-10-28, Cole's Vice side-by-side notes): live-now status in the hero, gifts beside the $100, the framing
  line, "basically a free wedge"; deal cards are ONE picture with the words on it and the whole card clickable, every set
  card says $100 off + towel + divot tool + what you save, a set opens a choose-your-lofts sheet; lifestyle strip from the
  night shoot; the shop is tabbed (Wedges / Putters / Hybrid / Apparel) with the ladder meter lighting up as you add;
  proof = the site's own trust line; an upcoming band for the driver and irons (Jan 6) with its own list.
  The money is the Lucky Discounts app's "Lucky club ladder" (Mobius Digital Tools/lucky-discounts): products tagged
  "club" count, $50 off 2, $100 off 3+. Gift: any club on LUCKYMAIL, 2+ clubs from Nov 24 (one set per order).
  Arriving with ?utm_source=postpilot or ?code=X applies the code (GET /discount/CODE). Preview a phase: ?bf_phase=live
{%- endcomment -%}
{%- liquid
  assign s = section.settings
  assign ship = settings.lg_free_shipping | default: 195
  assign carver = all_products['lucky-golf-lgw02-gold']
  assign rc = carver.metafields.reviews.rating_count.value | default: 0
  assign rv = carver.metafields.reviews.rating.value.rating
  assign jd = carver.metafields.judgeme.review_widget_data.value
  assign hero2400 = 'lg-bf-hero-2400.jpg' | asset_url
  assign hero1200 = 'lg-bf-hero-1200.jpg' | asset_url
  assign phase_keys = "mail,list,live,cm,over" | split: ","
  assign trust_lines = s.trust | newline_to_br | split: '<br />'
  assign trust_icons = s.trust_icons | split: ','
-%}
<div class="bf-page" data-bf-page data-phase="mail">

<section class="bf-hero">
  <div class="bf-hero-ph">
    {%- if s.hero_image != blank -%}
      {{ s.hero_image | image_url: width: 2400 | image_tag: alt: s.hero_alt, loading: 'eager', fetchpriority: 'high', widths: '750,1200,1600,2400', sizes: '100vw' }}
    {%- else -%}
      <img src="{{ hero1200 }}" srcset="{{ hero1200 }} 1200w, {{ hero2400 }} 2400w" sizes="100vw" alt="{{ s.hero_alt | escape }}" loading="eager" fetchpriority="high" width="2160" height="2700">
    {%- endif -%}
  </div>
  <div class="lg-wrap bf-hero-in">
    {%- for k in phase_keys -%}
      {%- assign st_key = k | append: '_status' -%}{%- assign h_key = k | append: '_heading' -%}{%- assign h2_key = k | append: '_heading2' -%}{%- assign d_key = k | append: '_deal' -%}
      <div class="bf-ph" data-bf-show="{{ k }}"{% unless k == 'mail' %} hidden{% endunless %}>
        {%- if s[st_key] != blank %}<p class="bf-live{% if k == 'cm' %} is-last{% elsif k == 'over' %} is-off{% endif %}"><i></i>{{ s[st_key] }}</p>{% endif -%}
        <div class="bf-h1-row">
          <{% if k == 'mail' %}h1{% else %}h2{% endif %} class="bf-h1"><span class="bf-big1">{{ s[h_key] }}</span><span class="bf-big">{{ s[h2_key] }}</span></{% if k == 'mail' %}h1{% else %}h2{% endif %}>
          {%- unless s.gifts_gone or k == 'over' -%}
          <p class="bf-plus"><span>+ free towel</span><span>+ free divot tool</span><small data-bf-gift-at>{{ s.plus_line }}</small></p>
          {%- endunless -%}
        </div>
        {%- if s.gifts_gone and k != 'over' -%}<p class="bf-deal">{{ s.gone_deal }}</p>
        {%- elsif s[d_key] != blank -%}<p class="bf-deal">{{ s[d_key] }}</p>{%- endif -%}
      </div>
    {%- endfor -%}

    <div class="bf-ticket" data-bf-show="mail list" data-bf-code hidden>
      <span class="bf-ticket-l"><small data-code-off>Code at checkout</small><small data-code-on hidden>Already in your bag</small><b data-code-text>{{ s.mail_code }}</b></span>
      <span class="bf-ticket-r" aria-hidden="true"><svg viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><path d="M20 6 9 17l-5-5"/></svg></span>
    </div>

    <div class="bf-go" data-bf-show="mail list live cm">
      <a class="lg-btn" href="#deals">{{ s.hero_btn }}</a>
      <a class="bf-go-2" href="#shop">{{ s.hero_btn2 }}</a>
    </div>
    <p class="bf-when" data-bf-show="mail list live cm">
      <span data-bf-ends>{{ s.ends_line }}</span>
      <span class="bf-clock" data-bf-clock hidden><span>{{ s.clock_label }}</span> <b data-d>0</b>d <b data-h>00</b>h <b data-m>00</b>m</span>
    </p>
    <div class="bf-lad-wrap" data-bf-show="mail list live cm">
      <ol class="bf-lad" aria-label="The ladder">
        <li><b>1 club</b><span data-lad-1>{{ s.lad_1 }}</span></li>
        <li><b>2 clubs</b><span>{{ s.lad_2 }}</span></li>
        <li><b>3 or more</b><span>{{ s.lad_3 }}</span></li>
      </ol>
      {%- if s.wedge_line != blank %}<p class="bf-lad-note">{{ s.wedge_line }}</p>{% endif -%}
    </div>

    <div class="bf-go" data-bf-show="over" hidden><a class="lg-btn" href="#shop">{{ s.over_btn }}</a></div>
  </div>
</section>

{%- assign cards = section.blocks | where: "type", "highlight" -%}
{%- if cards.size > 0 -%}
<section class="lg-wrap bf-sec" id="deals" data-bf-show="mail list live cm" aria-labelledby="bf-deals-h">
  <div class="bf-hd">
    <h2 class="bf-h" id="bf-deals-h"><span data-bf-show="mail list">{{ s.deals_title_early }}</span><span data-bf-show="live" hidden>{{ s.deals_title }}</span><span data-bf-show="cm" hidden>{{ s.deals_title_cm }}</span></h2>
    <p class="bf-l">{{ s.deals_line }}</p>
  </div>
  <div class="bf-cars" data-cars>
  <div class="bf-cards" data-cards>
    {%- for block in cards -%}{%- assign b = block.settings -%}
      {%- assign im_m = 'lg-bf-card-' | append: b.key | append: '-m.jpg' | asset_url -%}
      {%- assign im_d = 'lg-bf-card-' | append: b.key | append: '-d.jpg' | asset_url -%}
      {%- assign show = b.phases | default: 'mail list live cm' -%}
      {%- assign soon = b.soon_phases | default: '' -%}
      {%- if b.pieces != blank -%}
      <button type="button" class="bf-card{% if b.text_right %} is-right{% endif %}" data-card data-pieces="{{ b.pieces | escape }}" data-name="{{ b.name | escape }}" data-soon="{{ soon }}" data-bf-show="{{ show }}" {{ block.shopify_attributes }}>
      {%- else -%}
      <a class="bf-card{% if b.text_right %} is-right{% endif %}" href="{{ b.link | default: '#shop' }}" data-card data-soon="{{ soon }}" data-bf-show="{{ show }}" {{ block.shopify_attributes }}>
      {%- endif -%}
        <picture><source media="(min-width:750px)" srcset="{{ im_d }}"><img src="{{ im_m }}" alt="" loading="{% if forloop.index < 3 %}eager{% else %}lazy{% endif %}" width="942" height="1386"></picture>
        <span class="bf-card-tx">
          <span class="bf-card-top">
            <i class="bf-live is-sm" data-card-live><b></b><span data-card-live-t>{{ b.status | default: 'Live now' }}</span></i>
            <i class="bf-live is-sm is-soon" data-card-soon hidden><b></b><span>{{ b.soon_status | default: 'Coming Nov 24' }}</span></i>
            <i class="bf-live is-sm is-low" data-card-low hidden><b></b><span>Running low</span></i>
          </span>
          <span class="bf-card-bot">
            {%- if b.chip != blank %}<i class="bf-st is-gold">{{ b.chip }}</i>{% endif -%}
            <b class="bf-card-name">{{ b.name }}</b>
            <span class="bf-card-line">{{ b.line }}</span>
            <span class="bf-kit" data-card-kit>{%- if b.kit != blank -%}{%- assign kit = b.kit | split: '|' -%}{%- for k in kit -%}<i{% if forloop.index > 1 %} class="is-free"{% endif %}>{{ k | strip }}</i>{%- endfor -%}{%- endif -%}</span>
            <span class="bf-card-save" data-card-save>{% if b.save_line != blank %}{{ b.save_line }}{% endif %}</span>
            <span class="bf-card-pr" data-card-price>{% if b.price != blank %}<b>{{ b.price }}</b>{% endif %}</span>
            <span class="lg-btn bf-card-btn" data-card-btn>{{ b.btn | default: s.set_btn }}</span>
            <span class="lg-btn bf-card-btn is-soon" data-card-btn-soon hidden>{{ b.soon_btn | default: 'Tell me when' }}</span>
          </span>
        </span>
      {%- if b.pieces != blank %}</button>{% else %}</a>{% endif -%}
    {%- endfor -%}
    {%- if s.next_on -%}
    <button type="button" class="bf-card is-next" data-card data-next data-bf-show="mail list live cm">
      <picture><source media="(min-width:750px)" srcset="{{ 'lg-bf-card-next-d.jpg' | asset_url }}"><img src="{{ 'lg-bf-card-next-m.jpg' | asset_url }}" alt="" loading="lazy" width="942" height="1386"></picture>
      <span class="bf-card-tx">
        <span class="bf-card-top"><i class="bf-live is-sm is-soon"><b></b><span>{{ s.next_status }}</span></i></span>
        <span class="bf-card-bot">
          <i class="bf-st is-gold">Next</i>
          <b class="bf-card-name">{{ s.next_title }}</b>
          <span class="bf-card-line">{{ s.next_line }}</span>
          <span class="lg-btn bf-card-btn is-soon">{{ s.next_btn }}</span>
        </span>
      </span>
    </button>
    {%- endif -%}
  </div>
  <button type="button" class="bf-arr is-prev" data-cars-prev aria-label="Previous deal"><svg viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="m15 18-6-6 6-6"/></svg></button>
  <button type="button" class="bf-arr is-next" data-cars-next aria-label="Next deal"><svg viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="m9 18 6-6-6-6"/></svg></button>
  <div class="bf-dots" data-cars-dots aria-hidden="true"></div>
  </div>
</section>
{%- endif -%}

<section class="bf-life" aria-label="Lucky, on the course and off it">
  <div class="bf-life-row" data-life>
    {%- for pass in (1..2) -%}
    <div class="bf-life-set"{% if pass == 2 %} aria-hidden="true"{% endif %}>
      {%- for i in (1..18) -%}{%- assign lf = 'lg-bf-strip-' | append: i | append: '.jpg' | asset_url -%}
      <img src="{{ lf }}" alt="" loading="lazy" height="720">
      {%- endfor -%}
    </div>
    {%- endfor -%}
  </div>
</section>

<section class="lg-wrap bf-sec" id="shop" aria-labelledby="bf-shop-h">
  <div class="bf-hd">
    <h2 class="bf-h" id="bf-shop-h">{{ s.shop_title }}</h2>
    <p class="bf-l">{{ s.shop_line }}</p>
  </div>
  <div class="bf-tabs" role="tablist" aria-label="What to look at" data-tabs>
    <button type="button" role="tab" class="bf-tab" data-tab="wedges" aria-selected="true">Wedges</button>
    <button type="button" role="tab" class="bf-tab" data-tab="putters" aria-selected="false">Putters</button>
    <button type="button" role="tab" class="bf-tab" data-tab="hybrid" aria-selected="false">Hybrid</button>
  </div>
  <ol class="bf-meter" data-meter aria-label="What you get as you add clubs">
    <li data-m="1"><b>1 club</b><strong>Everyday price</strong><span>Already under the big names' sale</span></li>
    <li data-m="2"><b>2 clubs</b><strong>$50 off</strong><span>+ free towel + free divot tool</span></li>
    <li data-m="3"><b>3 or more</b><strong>$100 off</strong><span>+ both gifts + free shipping</span></li>
  </ol>
  <div class="bf-pcs" data-rows="wedges"></div>
  <div class="bf-pcs" data-rows="putters" hidden></div>
  <div class="bf-pcs" data-rows="hybrid" hidden></div>
</section>

{%- assign polos = section.blocks | where: "type", "polo" -%}
{%- capture retired -%}{%- for block in polos -%}{{ block.settings.product.handle }},{%- endfor -%}{%- endcapture -%}
{%- assign g_tabs = 'polos,hats' | split: ',' -%}
<section class="lg-wrap bf-sec" id="apparel" aria-labelledby="bf-app-h">
  <div class="bf-hd">
    <h2 class="bf-h" id="bf-app-h">{{ s.gear_title }}</h2>
    <p class="bf-l">{{ s.gear_line }}</p>
  </div>
  <div class="bf-tabs" role="tablist" aria-label="Apparel">
    {%- for t in g_tabs -%}{%- assign ck = t | append: '_coll' -%}{%- if s[ck] != blank -%}
    <button type="button" role="tab" class="bf-tab" data-gtab="{{ t }}" data-gset="app" aria-selected="{% if forloop.first %}true{% else %}false{% endif %}">{{ s[ck].title }}</button>
    {%- endif -%}{%- endfor -%}
  </div>
  {%- for t in g_tabs -%}{%- assign ck = t | append: '_coll' -%}{%- assign coll = s[ck] -%}{%- if coll != blank -%}
  <div class="bf-row" data-grow="{{ t }}" data-gset="app"{% unless forloop.first %} hidden{% endunless %}>
    <div class="bf-row-track" data-row-track>
      {%- for p in coll.products -%}{%- if p.available -%}{%- render 'lg-bf-gc', p: p, retired: retired, polo_price: s.polo_price, off: 0, bogo: s.app_bogo -%}{%- endif -%}{%- endfor -%}
    </div>
    <button type="button" class="bf-arr is-prev" data-row-prev aria-label="Back"><svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="m15 18-6-6 6-6"/></svg></button>
    <button type="button" class="bf-arr is-next" data-row-next aria-label="More"><svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="m9 18 6-6-6-6"/></svg></button>
  </div>
  {%- endif -%}{%- endfor -%}
</section>

{%- assign a_tabs = 'acc_1,acc_2,acc_3,acc_4,acc_5' | split: ',' -%}
{%- assign a_first = '' -%}{%- for t in a_tabs -%}{%- if s[t] != blank and s[t].products_count > 0 and a_first == '' -%}{%- assign a_first = t -%}{%- endif -%}{%- endfor -%}
{%- if a_first != '' -%}
<section class="lg-wrap bf-sec" id="accessories" aria-labelledby="bf-acc-h">
  <div class="bf-hd">
    <h2 class="bf-h" id="bf-acc-h">{{ s.acc_title }}</h2>
    <p class="bf-l">{{ s.acc_line }}</p>
  </div>
  <div class="bf-tabs" role="tablist" aria-label="Accessories">
    {%- for t in a_tabs -%}{%- if s[t] != blank and s[t].products_count > 0 -%}
    <button type="button" role="tab" class="bf-tab" data-gtab="{{ t }}" data-gset="acc" aria-selected="{% if t == a_first %}true{% else %}false{% endif %}">{{ s[t].title }}</button>
    {%- endif -%}{%- endfor -%}
  </div>
  {%- for t in a_tabs -%}{%- if s[t] != blank and s[t].products_count > 0 -%}
  <div class="bf-row" data-grow="{{ t }}" data-gset="acc"{% unless t == a_first %} hidden{% endunless %}>
    <div class="bf-row-track" data-row-track>
      {%- for p in s[t].products -%}{%- if p.available -%}{%- render 'lg-bf-gc', p: p, retired: retired, polo_price: s.polo_price, off: s.gear_off -%}{%- endif -%}{%- endfor -%}
    </div>
    <button type="button" class="bf-arr is-prev" data-row-prev aria-label="Back"><svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="m15 18-6-6 6-6"/></svg></button>
    <button type="button" class="bf-arr is-next" data-row-next aria-label="More"><svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="m9 18 6-6-6-6"/></svg></button>
  </div>
  {%- endif -%}{%- endfor -%}
</section>
{%- endif -%}

<section class="bf-proof" aria-label="Why Lucky">
  <div class="lg-wrap">
    <h2 class="bf-h bf-proof-h">{{ s.proof_title }}</h2>
    <div class="lg-trust bf-trust">
      {%- for t in trust_lines -%}{%- assign ic = trust_icons[forloop.index0] | strip | default: 'badge-check' -%}
      <span>{% render 'lg-icon', name: ic %}{{ t | strip }}</span>
      {%- endfor -%}
    </div>
    {%- if jd.reviews.size > 0 -%}
    <ul class="bf-revs">
      {%- assign shown = 0 -%}
      {%- for r in jd.reviews -%}
        {%- if r.rating >= 5 and r.body.size > 40 and shown < 3 -%}
          {%- assign shown = shown | plus: 1 -%}
          <li><p>"{{ r.body | strip | truncate: 140 }}"</p><small>{{ r.reviewer_name | default: 'A golfer' }}{% if r.verified_buyer %} · Verified{% endif %}</small></li>
        {%- endif -%}
      {%- endfor -%}
    </ul>
    {%- endif -%}
  </div>
</section>

<section class="lg-wrap bf-sec bf-faq" id="questions" aria-labelledby="bf-q-h">
  <div class="bf-hd"><h2 class="bf-h" id="bf-q-h">{{ s.faq_title }}</h2></div>
  <div class="lg-faq">
    {%- for i in (1..6) -%}
      {%- assign qk = 'q' | append: i -%}{%- assign ak = 'a' | append: i -%}
      {%- if s[qk] != blank -%}
      <details class="lg-fq"><summary>{{ s[qk] }}</summary><div class="lg-fq-a"><p>{% if i == 4 and s.gifts_gone %}{{ s.a4_gone }}{% else %}{{ s[ak] | replace: '[ship]', ship | replace: '[std]', s.xmas_std }}{% endif %}</p></div></details>
      {%- endif -%}
    {%- endfor -%}
  </div>
</section>

<section class="bf-list" id="list" data-bf-list hidden aria-labelledby="bf-list-h">
  <div class="lg-wrap bf-list-in">
    <div>
      <p class="bf-stamp">{{ s.list_stamp }}</p>
      <h2 class="bf-h" id="bf-list-h"><span data-bf-show="mail">{{ s.list_title_before }}</span><span data-bf-show="list live cm over" hidden>{{ s.list_title_after }}</span></h2>
      <p class="bf-l"><span data-bf-show="mail">{{ s.list_line_before }}</span><span data-bf-show="list live cm over" hidden>{{ s.list_line_after }}</span></p>
    </div>
    <form class="bf-form" data-bf-form data-source="Black Friday page" novalidate>
      <label class="sr" for="bf-email">Email</label>
      <input id="bf-email" name="email" type="email" inputmode="email" autocomplete="email" placeholder="you@email.com" required>
      <button type="submit" class="lg-btn">{{ s.list_btn }}</button>
      <p class="bf-form-msg" data-bf-form-msg hidden></p>
    </form>
  </div>
</section>

<div class="bf-bar" data-bf-bar hidden>
  <div class="bf-bar-in">
    <div class="bf-bar-txt"><b data-bar-total></b><span data-bar-sub></span></div>
    <button type="button" class="lg-btn" data-bar-add>{{ s.bar_btn }}</button>
  </div>
  <p class="bf-bar-nudge" data-bar-nudge hidden></p>
</div>

<div class="bf-sheet" data-sheet hidden>
  <div class="bf-sheet-bg" data-sheet-close></div>
  <div class="bf-sheet-in" role="dialog" aria-modal="true" aria-labelledby="bf-sheet-h">
    <button type="button" class="bf-sheet-x" data-sheet-close aria-label="Close">&times;</button>
    <p class="bf-stamp">{{ s.sheet_stamp }}</p>
    <h3 class="bf-h bf-sheet-h" id="bf-sheet-h" data-sheet-name></h3>
    <p class="bf-l" data-sheet-line>{{ s.sheet_line }}</p>
    <div class="bf-sheet-rows" data-sheet-rows></div>
    <ul class="bf-r-lines" data-sheet-lines></ul>
    <div class="bf-r-sum" data-sheet-sum></div>
    <p class="bf-r-total"><span>Today</span><b data-sheet-total></b></p>
    <button type="button" class="lg-btn lg-btn-block" data-sheet-add>{{ s.set_btn }}</button>
    <form class="bf-form is-light" data-bf-form data-sheet-form data-source="Driver and irons list" data-list="{{ s.next_list }}" novalidate hidden>
      <label class="sr" for="bf-next-email">Email</label>
      <input id="bf-next-email" name="email" type="email" inputmode="email" autocomplete="email" placeholder="you@email.com" required>
      <button type="submit" class="lg-btn">{{ s.next_btn }}</button>
      <p class="bf-form-msg" data-bf-form-msg hidden></p>
    </form>
  </div>
</div>
</div>

<script>
window.LG_BF = {
  phases: [['list', {{ s.list_start | json }}], ['live', {{ s.live_start | json }}], ['cm', {{ s.cm_start | json }}], ['over', {{ s.end | json }}]],
  end: {{ s.end | json }},
  clockHours: {{ s.clock_hours | default: 48 }},
  codes: { mail: {{ s.mail_code | json }}, list: {{ s.list_code | json }} },
  autoSources: {{ s.auto_sources | json }},
  giftsGone: {{ s.gifts_gone | json }},
  ship: {{ ship | times: 100 }},
  shipCost: {{ s.ship_cost | default: 18 | times: 100 }},
  lowAt: {{ s.low_at | default: 60 }},
  worth: { towel: {{ s.towel_worth | default: 0 | times: 100 }}, divot: {{ s.divot_worth | default: 0 | times: 100 }}, cover: {{ s.cover_worth | default: 0 | times: 100 }} },
  say: { bar: {{ s.bar_btn | json }}, lad1Mail: {{ s.lad_1_mail | json }}, plusMail: {{ s.plus_line_mail | json }} },
  klaviyo: { key: {{ settings.lg_klaviyo_public_key | json }}, list: {{ s.klaviyo_list | default: settings.lg_klaviyo_list | json }} },
  clubs: [
    {%- for block in section.blocks -%}{%- if block.type == 'club' or block.type == 'drop' -%}{%- assign b = block.settings -%}{%- assign p = b.product -%}
    {%- if p != blank -%}
    {%- assign cut = p.metafields.custom.cutout.value -%}
    {%- if block.type == 'drop' %}{% assign isdrop = true %}{% else %}{% assign isdrop = false %}{% endif -%}
    {%- assign prc = p.metafields.reviews.rating_count.value | default: 0 -%}{%- assign prv = p.metafields.reviews.rating.value.rating -%}
    { key: {{ b.key | json }}, drop: {{ isdrop }}, group: {{ b.group | default: 'putters' | json }}, name: {{ b.name | default: p.title | json }}, line: {{ b.line | json }}, finish: {{ b.finish | json }}, url: {{ p.url | json }},
      cover: {{ b.cover | default: false }}, stars: {% if prc >= 10 and prv %}{{ prv | round: 1 }}{% else %}0{% endif %},
      img: {% if b.image != blank %}{{ b.image | image_url: width: 800 | json }}{% elsif cut != blank %}{{ cut | image_url: width: 800 | json }}{% else %}{{ p.featured_image | image_url: width: 800 | json }}{% endif %},
      img2: {% if p.images.size > 1 %}{{ p.images[1] | image_url: width: 800 | json }}{% else %}""{% endif %},
      opts: {{ p.options | json }},
      variants: [{%- for v in p.variants -%}{ id: {{ v.id }}, o: {{ v.options | json }}, a: {{ v.available }}, q: {{ v.inventory_quantity | default: 0 }}, p: {{ v.price }} }{% unless forloop.last %},{% endunless %}{%- endfor -%}] },
    {%- endif -%}
    {%- endif -%}{%- endfor -%}
    null
  ].filter(Boolean)
};
</script>
