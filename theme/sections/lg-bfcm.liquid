{%- comment -%}
  The Black Friday / Cyber Monday 2026 page (/pages/black-friday, template page.black-friday).
  ONE stable URL for every phase, so the PostPilot QR printed in October never breaks:
    mail  (until Nov 23)  direct mail early access, code LUCKYMAIL
    list  (Nov 24 to 25)  email/SMS early access
    live  (Nov 26 to 29)  Black Friday for everyone, automatic
    cm    (Nov 30)        Cyber Monday, last day
    over  (Dec 1 on)      deal over, clubs still here
  Round 2 (2026-10-27, Cole: "plain, boring, not optimized"): sell on the page. Hero = the biggest number,
  a receipt that does the math, one-tap sets, a build-your-own tray with a sticky total and the next-rung nudge.
  The money is the Lucky Discounts app's "Lucky club ladder" (Mobius Digital Tools/lucky-discounts): products
  tagged "club" count, $50 off 2, $100 off 3+. Gift: any club on LUCKYMAIL, 2+ clubs from Nov 24 (one set per order).
  Arriving with ?utm_source=postpilot or ?code=X applies the code (GET /discount/CODE). Preview a phase: ?bf_phase=live
{%- endcomment -%}
{%- liquid
  assign s = section.settings
  assign hero = s.hero_image | default: images['lg-carver-sets-hero.jpg']
  assign ship = settings.lg_free_shipping | default: 195
  assign carver = all_products['lucky-golf-lgw02-gold']
  assign rc = carver.metafields.reviews.rating_count.value | default: 0
  assign rv = carver.metafields.reviews.rating.value.rating
-%}
<div class="bf-page" data-bf-page data-phase="mail">

<section class="bf-hero">
  <div class="bf-hero-ph">{%- if hero != blank -%}{{ hero | image_url: width: 2400 | image_tag: alt: s.hero_alt, loading: 'eager', fetchpriority: 'high', widths: '750,1200,1600,2000,2400', sizes: '100vw' }}{%- endif -%}</div>
  <div class="lg-wrap bf-hero-in">
    {%- for ph in (1..5) -%}
      {%- case ph -%}
        {%- when 1 -%}{%- assign k = 'mail' -%}
        {%- when 2 -%}{%- assign k = 'list' -%}
        {%- when 3 -%}{%- assign k = 'live' -%}
        {%- when 4 -%}{%- assign k = 'cm' -%}
        {%- when 5 -%}{%- assign k = 'over' -%}
      {%- endcase -%}
      {%- assign e_key = k | append: '_eyebrow' -%}{%- assign h_key = k | append: '_heading' -%}{%- assign h2_key = k | append: '_heading2' -%}{%- assign d_key = k | append: '_deal' -%}{%- assign l_key = k | append: '_lede' -%}
      <div class="bf-ph" data-bf-show="{{ k }}"{% unless k == 'mail' %} hidden{% endunless %}>
        {%- if s[e_key] != blank %}<p class="bf-stamp">{{ s[e_key] }}</p>{% endif -%}
        <{% if k == 'mail' %}h1{% else %}h2{% endif %} class="bf-h1"><span class="bf-big">{{ s[h_key] }}</span>{% if s[h2_key] != blank %}<span class="bf-big2">{{ s[h2_key] }}</span>{% endif %}</{% if k == 'mail' %}h1{% else %}h2{% endif %}>
        {%- if s.gifts_gone and k != 'over' -%}<p class="bf-deal">{{ s.gone_deal }}</p>
        {%- elsif s[d_key] != blank -%}<p class="bf-deal">{{ s[d_key] }}</p>{%- endif -%}
        {%- if s[l_key] != blank %}<p class="bf-lede">{{ s[l_key] }}</p>{% endif -%}
      </div>
    {%- endfor -%}

    <div class="bf-ticket" data-bf-show="mail list" data-bf-code hidden>
      <span class="bf-ticket-l"><small data-code-off>Code at checkout</small><small data-code-on hidden>Already in your bag</small><b data-code-text>{{ s.mail_code }}</b></span>
      <span class="bf-ticket-r" aria-hidden="true"><svg viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><path d="M20 6 9 17l-5-5"/></svg></span>
    </div>

    <div class="bf-go" data-bf-show="mail list live cm">
      <a class="lg-btn" href="#sets">{{ s.hero_btn }}</a>
      <a class="bf-go-2" href="#build">{{ s.hero_btn2 }}</a>
    </div>
    <p class="bf-clock" data-bf-show="mail list live cm" data-bf-clock><span>{{ s.clock_label }}</span> <b data-d>0</b>d <b data-h>00</b>h <b data-m>00</b>m</p>
    <div class="bf-go" data-bf-show="over" hidden><a class="lg-btn" href="#build">{{ s.over_btn }}</a></div>
  </div>
</section>

<ul class="bf-strip">
  {%- if rc >= 10 and rv %}<li>{% render 'lg-icon', name: 'star' %}{{ rv | round: 1 }} stars from {{ rc }} golfers</li>{% endif -%}
  <li>{% render 'lg-icon', name: 'truck' %}Free shipping on ${{ ship }} and up</li>
  <li>{% render 'lg-icon', name: 'rotate-ccw' %}{{ s.trust_days }}</li>
</ul>

<section class="lg-wrap bf-sec bf-math" id="math" data-bf-show="mail list live cm" aria-labelledby="bf-math-h">
  <div class="bf-math-copy">
    <h2 class="bf-h" id="bf-math-h">{{ s.math_title }}</h2>
    <p class="bf-l">{{ s.math_line }}</p>
    <div class="bf-n" role="tablist" aria-label="How many clubs">
      {%- for n in (1..3) -%}<button type="button" role="tab" class="bf-n-b" data-n="{{ n }}" aria-selected="{% if n == 3 %}true{% else %}false{% endif %}">{{ n }}{% if n == 3 %}+{% endif %} {% if n == 1 %}club{% else %}clubs{% endif %}</button>{%- endfor -%}
    </div>
    <ul class="bf-rungs">
      <li data-rung="1"><b>1 club</b><span data-rung-text="1"></span></li>
      <li data-rung="2"><b>2 clubs</b><span>$50 off</span></li>
      <li data-rung="3"><b>3 or more</b><span>$100 off + free shipping</span></li>
    </ul>
  </div>
  <figure class="bf-receipt" aria-live="polite">
    <p class="bf-r-head">Lucky Golf<br><small data-r-date></small></p>
    <ul class="bf-r-lines" data-r-lines></ul>
    <p class="bf-r-total"><span>Total</span><b data-r-total></b></p>
    <p class="bf-r-save" data-r-save></p>
    <figcaption class="bf-r-foot">It's better to be lucky.</figcaption>
  </figure>
</section>

<section class="lg-wrap bf-sec" id="sets" data-bf-show="mail list live cm" aria-labelledby="bf-sets-h">
  <h2 class="bf-h" id="bf-sets-h">{{ s.sets_title }}</h2>
  <p class="bf-l">{{ s.sets_line }}</p>
  <div class="bf-sets" data-sets></div>
</section>

<section class="lg-wrap bf-sec" id="build" aria-labelledby="bf-build-h">
  <div class="bf-build-hd">
    <div><h2 class="bf-h" id="bf-build-h">{{ s.build_title }}</h2><p class="bf-l">{{ s.build_line }}</p></div>
    <div class="bf-hands" role="group" aria-label="Hand" data-hands></div>
  </div>
  <div class="bf-rows" data-rows></div>
</section>

<section class="lg-wrap bf-sec bf-faq" id="questions" aria-labelledby="bf-q-h">
  <h2 class="bf-h" id="bf-q-h">{{ s.faq_title }}</h2>
  <div class="lg-faq">
    {%- for i in (1..8) -%}
      {%- assign qk = 'q' | append: i -%}{%- assign ak = 'a' | append: i -%}
      {%- if s[qk] != blank -%}
      <details class="lg-fq"><summary>{{ s[qk] }}</summary><div class="lg-fq-a"><p>{% if i == 3 and s.gifts_gone %}{{ s.a3_gone }}{% else %}{{ s[ak] | replace: '[ship]', ship }}{% endif %}</p></div></details>
      {%- endif -%}
    {%- endfor -%}
  </div>
</section>

<section class="bf-sign">
  <p class="bf-sign-t">It's better to be lucky.</p>
  <p class="bf-l">{{ s.sign_line }}</p>
  <a class="lg-btn" href="#sets">{{ s.hero_btn }}</a>
</section>

<div class="bf-bar" data-bf-bar hidden>
  <div class="bf-bar-in">
    <div class="bf-bar-txt"><b data-bar-total></b><span data-bar-sub></span></div>
    <button type="button" class="lg-btn" data-bar-add>{{ s.bar_btn }}</button>
  </div>
  <p class="bf-bar-nudge" data-bar-nudge hidden></p>
</div>
</div>

<script>
window.LG_BF = {
  phases: [['list', {{ s.list_start | json }}], ['live', {{ s.live_start | json }}], ['cm', {{ s.cm_start | json }}], ['over', {{ s.end | json }}]],
  end: {{ s.end | json }},
  codes: { mail: {{ s.mail_code | json }}, list: {{ s.list_code | json }} },
  autoSources: {{ s.auto_sources | json }},
  giftsGone: {{ s.gifts_gone | json }},
  ship: {{ ship | times: 100 }},
  sets: {{ s.sets | json }},
  say: { add: {{ s.set_btn | json }}, bar: {{ s.bar_btn | json }} },
  clubs: [
    {%- for block in section.blocks -%}{%- assign b = block.settings -%}{%- assign p = b.product -%}
    {%- if p != blank -%}
    {%- assign cut = p.metafields.custom.cutout.value -%}
    { key: {{ b.key | json }}, name: {{ b.name | default: p.title | json }}, line: {{ b.line | json }}, finish: {{ b.finish | json }}, url: {{ p.url | json }},
      img: {% if b.image != blank %}{{ b.image | image_url: width: 600 | json }}{% elsif cut != blank %}{{ cut | image_url: width: 600 | json }}{% else %}{{ p.featured_image | image_url: width: 600 | json }}{% endif %},
      opts: {{ p.options | json }},
      variants: [{%- for v in p.variants -%}{ id: {{ v.id }}, o: {{ v.options | json }}, a: {{ v.available }}, p: {{ v.price }}, img: {% if v.featured_image %}{{ v.featured_image | image_url: width: 600 | json }}{% else %}null{% endif %} }{% unless forloop.last %},{% endunless %}{%- endfor -%}] }{% unless forloop.last %},{% endunless %}
    {%- endif -%}
    {%- endfor -%}
  ]
};
</script>
{{ 'lg-bfcm.css' | asset_url | stylesheet_tag }}
<script src="{{ 'lg-bfcm.js' | asset_url }}" defer></script>

{% schema %}
{
  "name": "Black Friday page",
  "tag": "section",
  "class": "lg-scope",
  "settings": [
    { "type": "paragraph", "content": "One page for every phase. Dates are Central time, written like 2026-11-24T00:00:00-06:00. The discount itself is the Lucky Discounts app (Discounts in admin)." },
    { "type": "header", "content": "Dates" },
    { "type": "text", "id": "list_start", "label": "List early access starts", "default": "2026-11-24T00:00:00-06:00" },
    { "type": "text", "id": "live_start", "label": "Black Friday for everyone starts", "default": "2026-11-26T00:00:00-06:00" },
    { "type": "text", "id": "cm_start", "label": "Cyber Monday starts", "default": "2026-11-30T00:00:00-06:00" },
    { "type": "text", "id": "end", "label": "Deal ends", "default": "2026-12-01T00:00:00-06:00" },
    { "type": "header", "content": "Codes and gifts" },
    { "type": "text", "id": "mail_code", "label": "Direct mail code", "default": "LUCKYMAIL" },
    { "type": "text", "id": "list_code", "label": "List early access code", "info": "Empty: the list phase shows the mail code." },
    { "type": "text", "id": "auto_sources", "label": "utm_source values that get the code applied for them", "default": "postpilot" },
    { "type": "checkbox", "id": "gifts_gone", "label": "Towels and divot tools are gone", "default": false, "info": "Tick when stock hits zero: gift copy comes off every phase." },
    { "type": "text", "id": "gone_deal", "label": "Deal line once gifts are gone", "default": "Gifts are gone. $50 off 2 clubs, $100 off 3 or more still on." },
    { "type": "header", "content": "Hero" },
    { "type": "image_picker", "id": "hero_image", "label": "Hero photo", "info": "Empty: lg-carver-sets-hero.jpg from Files." },
    { "type": "text", "id": "hero_alt", "label": "Hero photo alt text", "default": "Carver 02 wedges on the fringe" },
    { "type": "text", "id": "hero_btn", "label": "Hero button", "default": "Grab a set" },
    { "type": "text", "id": "hero_btn2", "label": "Hero second link", "default": "Or build your own" },
    { "type": "text", "id": "clock_label", "label": "Countdown label", "default": "Ends Cyber Monday in" },
    { "type": "text", "id": "mail_eyebrow", "label": "Mail: stamp", "default": "Postcard early access" },
    { "type": "text", "id": "mail_heading", "label": "Mail: big line", "default": "$100 off" },
    { "type": "text", "id": "mail_heading2", "label": "Mail: second line", "default": "three clubs." },
    { "type": "text", "id": "mail_deal", "label": "Mail: deal line", "default": "$50 off two. And any club comes with a free towel and divot tool." },
    { "type": "text", "id": "mail_lede", "label": "Mail: line", "default": "You got the postcard, so you're in a month before everyone else. The code's already in your bag." },
    { "type": "text", "id": "list_eyebrow", "label": "List: stamp", "default": "Early access · Two days before everyone" },
    { "type": "text", "id": "list_heading", "label": "List: big line", "default": "$100 off" },
    { "type": "text", "id": "list_heading2", "label": "List: second line", "default": "three clubs." },
    { "type": "text", "id": "list_deal", "label": "List: deal line", "default": "$50 off two. Two or more clubs get a free towel and divot tool." },
    { "type": "text", "id": "list_lede", "label": "List: line", "default": "First pick of every loft before Thanksgiving shows up." },
    { "type": "text", "id": "live_eyebrow", "label": "Black Friday: stamp", "default": "Black Friday · No code needed" },
    { "type": "text", "id": "live_heading", "label": "Black Friday: big line", "default": "$100 off" },
    { "type": "text", "id": "live_heading2", "label": "Black Friday: second line", "default": "three clubs." },
    { "type": "text", "id": "live_deal", "label": "Black Friday: deal line", "default": "$50 off two. Two or more clubs get a free towel and divot tool." },
    { "type": "text", "id": "live_lede", "label": "Black Friday: line", "default": "The price drops in your bag. Nothing to type." },
    { "type": "text", "id": "cm_eyebrow", "label": "Cyber Monday: stamp", "default": "Cyber Monday · Last day" },
    { "type": "text", "id": "cm_heading", "label": "Cyber Monday: big line", "default": "Last call" },
    { "type": "text", "id": "cm_heading2", "label": "Cyber Monday: second line", "default": "$100 off three." },
    { "type": "text", "id": "cm_deal", "label": "Cyber Monday: deal line", "default": "$50 off two. Two or more clubs get a free towel and divot tool." },
    { "type": "text", "id": "cm_lede", "label": "Cyber Monday: line", "default": "Ends at midnight Central. Then it's full price until next year." },
