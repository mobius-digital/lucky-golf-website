{%- comment -%}
  The Black Friday / Cyber Monday 2026 page (/pages/black-friday, template page.black-friday).
  ONE stable URL for every phase, so the PostPilot QR printed in October never breaks:
    mail  (until Nov 23)  direct mail early access, code LUCKYMAIL
    list  (Nov 24 to 25)  email/SMS early access
    live  (Nov 26 to 29)  Black Friday for everyone, automatic
    cm    (Nov 30)        Cyber Monday, last day
    over  (Dec 1 on)      order by Christmas: deal over, clubs still here
  Round 3 (2026-10-27, from the wireframe): hero = the offer in one line + the three-rung ladder, the black Eclipse drop
  with status chips (Vice), one-tap sets with chips, build-your-own next to a live receipt, their-price-vs-ours + trust +
  real Judge.me reviews, the gifts with a live count, retired polos rail, a shipping timeline (Takomo), 6 questions,
  a join-the-list block for non-members, sticky bar. Countdown only inside the last 48 hours.
  The money is the Lucky Discounts app's "Lucky club ladder" (Mobius Digital Tools/lucky-discounts): products tagged
  "club" count, $50 off 2, $100 off 3+. Gift: any club on LUCKYMAIL, 2+ clubs from Nov 24 (one set per order).
  Arriving with ?utm_source=postpilot or ?code=X applies the code (GET /discount/CODE). Preview a phase: ?bf_phase=live
{%- endcomment -%}
{%- liquid
  assign s = section.settings
  assign ship = settings.lg_free_shipping | default: 195
  assign carver = all_products['lucky-golf-lgw02-gold']
  assign rc = carver.metafields.reviews.rating_count.value | default: 0
  assign rv = carver.metafields.reviews.rating.value.rating
  assign jd = carver.metafields.judgeme.review_widget_data.value
  assign hero2400 = 'lg-bf-hero-2400.jpg' | asset_url
  assign hero1200 = 'lg-bf-hero-1200.jpg' | asset_url
-%}
<div class="bf-page" data-bf-page data-phase="mail">

<p class="bf-top">
  <span data-bf-show="mail">{{ s.top_mail }}</span>
  <span data-bf-show="list" hidden>{{ s.top_list }}</span>
  <span data-bf-show="live" hidden>{{ s.top_live }}</span>
  <span data-bf-show="cm" hidden>{{ s.top_cm }}</span>
  <span data-bf-show="over" hidden>{{ s.top_over | replace: '[std]', s.xmas_std | replace: '[exp]', s.xmas_exp }}</span>
</p>

<section class="bf-hero">
  <div class="bf-hero-ph">
    {%- if s.hero_image != blank -%}
      {{ s.hero_image | image_url: width: 2400 | image_tag: alt: s.hero_alt, loading: 'eager', fetchpriority: 'high', widths: '750,1200,1600,2400', sizes: '100vw' }}
    {%- else -%}
      <img src="{{ hero1200 }}" srcset="{{ hero1200 }} 1200w, {{ hero2400 }} 2400w" sizes="100vw" alt="{{ s.hero_alt | escape }}" loading="eager" fetchpriority="high" width="2160" height="2700">
    {%- endif -%}
  </div>
  <div class="lg-wrap bf-hero-in">
    {%- assign phase_keys = "mail,list,live,cm,over" | split: "," -%}
    {%- for k in phase_keys -%}
      {%- assign e_key = k | append: '_eyebrow' -%}{%- assign h_key = k | append: '_heading' -%}{%- assign h2_key = k | append: '_heading2' -%}{%- assign d_key = k | append: '_deal' -%}{%- assign l_key = k | append: '_lede' -%}
      <div class="bf-ph" data-bf-show="{{ k }}"{% unless k == 'mail' %} hidden{% endunless %}>
        {%- if s[e_key] != blank %}<p class="bf-stamp">{{ s[e_key] }}</p>{% endif -%}
        <{% if k == 'mail' %}h1{% else %}h2{% endif %} class="bf-h1"><span class="bf-big1">{{ s[h_key] }}</span><span class="bf-big">{{ s[h2_key] }}</span></{% if k == 'mail' %}h1{% else %}h2{% endif %}>
        {%- if s.gifts_gone and k != 'over' -%}<p class="bf-deal">{{ s.gone_deal }}</p>
        {%- elsif s[d_key] != blank -%}<p class="bf-deal">{{ s[d_key] }}</p>{%- endif -%}
        {%- if s[l_key] != blank %}<p class="bf-lede">{{ s[l_key] }}</p>{% endif -%}
      </div>
    {%- endfor -%}

    <ol class="bf-lad" data-bf-show="mail list live cm" aria-label="The ladder">
      <li><b>1 club</b><span data-lad-1>{{ s.lad_1 }}</span></li>
      <li><b>2 clubs</b><span>{{ s.lad_2 }}</span></li>
      <li><b>3 or more</b><span>{{ s.lad_3 }}</span></li>
    </ol>

    <div class="bf-ticket" data-bf-show="mail list" data-bf-code hidden>
      <span class="bf-ticket-l"><small data-code-off>Code at checkout</small><small data-code-on hidden>Already in your bag</small><b data-code-text>{{ s.mail_code }}</b></span>
      <span class="bf-ticket-r" aria-hidden="true"><svg viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><path d="M20 6 9 17l-5-5"/></svg></span>
    </div>

    <div class="bf-go" data-bf-show="mail list live cm">
      <a class="lg-btn" href="#build">{{ s.hero_btn }}</a>
      <a class="bf-go-2" href="#sets">{{ s.hero_btn2 }}</a>
    </div>
    <p class="bf-when" data-bf-show="mail list live cm">
      <span data-bf-nocode>{{ s.nocode_line }}</span>
      <span data-bf-ends>{{ s.ends_line }}</span>
      <span class="bf-clock" data-bf-clock hidden><span>{{ s.clock_label }}</span> <b data-d>0</b>d <b data-h>00</b>h <b data-m>00</b>m</span>
    </p>
    <div class="bf-go" data-bf-show="over" hidden><a class="lg-btn" href="#build">{{ s.over_btn }}</a></div>
  </div>
</section>

{%- if s.drop_on -%}
{%- assign dm = all_products[s.drop_mallet] -%}{%- assign db = all_products[s.drop_blade] -%}
<section class="bf-drop" id="drop" aria-labelledby="bf-drop-h">
  <div class="lg-wrap bf-drop-in">
    <div class="bf-drop-ph" aria-hidden="true">
      {%- assign dbc = db.metafields.custom.cutout.value -%}{%- assign dmc = dm.metafields.custom.cutout.value -%}
      {%- if dbc != blank %}<img src="{{ dbc | image_url: width: 700 }}" alt="" loading="lazy" class="bf-sil">{% elsif db.featured_image %}<img src="{{ db.featured_image | image_url: width: 700 }}" alt="" loading="lazy" class="bf-sil is-flat">{% endif -%}
      {%- if dmc != blank %}<img src="{{ dmc | image_url: width: 700 }}" alt="" loading="lazy" class="bf-sil">{% elsif dm.featured_image %}<img src="{{ dm.featured_image | image_url: width: 700 }}" alt="" loading="lazy" class="bf-sil is-flat">{% endif -%}
    </div>
    <div class="bf-drop-bd">
      <p class="bf-stamp">{{ s.drop_stamp }}</p>
      <h2 class="bf-h" id="bf-drop-h">{{ s.drop_title }}</h2>
      <p class="bf-l" data-bf-show="mail">{{ s.drop_mail }}</p>
      <p class="bf-l" data-bf-show="list live cm" hidden>{{ s.drop_live }}</p>
      <p class="bf-l" data-bf-show="over" hidden>{{ s.drop_over }}</p>
      <ul class="bf-chips-s">
        <li class="bf-st is-soon" data-bf-show="mail">Coming {{ s.list_start | date: '%b %-d' }}</li>
        <li class="bf-st is-on" data-bf-show="list live cm" hidden>Live now</li>
        <li class="bf-st" data-bf-show="list live cm" hidden>First time on sale</li>
        <li class="bf-st" data-bf-show="mail list live cm">Counts as a club</li>
      </ul>
      <div class="bf-drop-rows" data-drop-rows data-bf-show="list live cm" hidden></div>
      <div class="bf-go" data-bf-show="mail"><a class="lg-btn lg-btn-line" href="#list">{{ s.drop_btn }}</a></div>
    </div>
  </div>
</section>
{%- endif -%}

<section class="lg-wrap bf-sec" id="sets" data-bf-show="mail list live cm" aria-labelledby="bf-sets-h">
  <h2 class="bf-h" id="bf-sets-h">{{ s.sets_title }}</h2>
  <p class="bf-l">{{ s.sets_line }}</p>
  <div class="bf-sets" data-sets></div>
</section>

<section class="lg-wrap bf-sec bf-build" id="build" aria-labelledby="bf-build-h">
  <div class="bf-build-l">
    <div class="bf-build-hd">
      <div><h2 class="bf-h" id="bf-build-h">{{ s.build_title }}</h2><p class="bf-l">{{ s.build_line }}</p></div>
      <div class="bf-hands" role="group" aria-label="Hand" data-hands></div>
    </div>
    <div class="bf-rows" data-rows></div>
  </div>
  <div class="bf-build-r">
    <figure class="bf-receipt" aria-live="polite">
      <p class="bf-r-head">Lucky Golf<br><small data-r-date></small></p>
      <div class="bf-n" role="tablist" aria-label="How many clubs" data-r-tabs>
        {%- for n in (1..3) -%}<button type="button" role="tab" class="bf-n-b" data-n="{{ n }}" aria-selected="{% if n == 3 %}true{% else %}false{% endif %}">{{ n }}{% if n == 3 %}+{% endif %} {% if n == 1 %}club{% else %}clubs{% endif %}</button>{%- endfor -%}
      </div>
      <ul class="bf-r-lines" data-r-lines></ul>
      <p class="bf-r-total"><span>Total</span><b data-r-total></b></p>
      <p class="bf-r-save" data-r-save></p>
      <button type="button" class="lg-btn lg-btn-block" data-r-add hidden>{{ s.bar_btn }}</button>
      <figcaption class="bf-r-foot">It's better to be lucky.</figcaption>
    </figure>
  </div>
</section>

<section class="bf-why" id="why" aria-labelledby="bf-why-h">
  <div class="lg-wrap">
    <div class="bf-why-g">
      <div>
        <h2 class="bf-h" id="bf-why-h">{{ s.why_title }}</h2>
        <p class="bf-l">{{ s.why_line }}</p>
        <table class="bf-vs"><tbody>
          <tr><td>{{ s.vs_them }}</td><td>{{ s.vs_them_price }}</td></tr>
          <tr class="is-us"><td>{{ s.vs_us }}</td><td>{{ s.vs_us_price }}</td></tr>
        </tbody></table>
      </div>
      <ul class="bf-trust">
        {%- if rc >= 10 and rv %}<li><b>{{ rv | round: 1 }}</b><span>stars from {{ rc }} golfers</span></li>{% endif -%}
        <li><b>{{ s.trust_2_big }}</b><span>{{ s.trust_2 }}</span></li>
        <li><b>{{ s.trust_3_big }}</b><span>{{ s.trust_3 }}</span></li>
      </ul>
    </div>
    {%- if jd.reviews.size > 0 -%}
    <ul class="bf-revs">
      {%- assign shown = 0 -%}
      {%- for r in jd.reviews -%}
        {%- if r.rating >= 5 and r.body.size > 40 and shown < 3 -%}
          {%- assign shown = shown | plus: 1 -%}
          <li><p>"{{ r.body | strip | truncate: 170 }}"</p><small>{{ r.reviewer_name | default: 'A golfer' }}{% if r.verified_buyer %} · Verified{% endif %}</small></li>
        {%- endif -%}
      {%- endfor -%}
    </ul>
    {%- endif -%}
  </div>
</section>

<section class="lg-wrap bf-sec bf-gifts" id="gifts" data-bf-show="mail list live cm" aria-labelledby="bf-gifts-h">
  <div class="bf-gifts-g">
    <div class="bf-gift-tiles" aria-hidden="true">
      <div class="bf-gift"><b>Towel</b><span>{{ s.gift_towel_line }}</span></div>
      <div class="bf-gift"><b>Divot tool</b><span>{{ s.gift_divot_line }}</span></div>
    </div>
    <div>
      <h2 class="bf-h" id="bf-gifts-h">{{ s.gifts_title }}</h2>
      {%- if s.gifts_gone -%}<p class="bf-l">{{ s.gone_deal }}</p>
      {%- else -%}
      <p class="bf-l" data-bf-show="mail">{{ s.gifts_mail }}</p>
      <p class="bf-l" data-bf-show="list live cm" hidden>{{ s.gifts_line }}</p>
      {%- if s.gift_sets_left > 0 %}<p class="bf-st is-low bf-st-big">{{ s.gift_sets_left }} sets left</p>{% endif -%}
      {%- endif -%}
    </div>
  </div>
</section>

{%- assign polos = section.blocks | where: "type", "polo" -%}
{%- if polos.size > 0 -%}
<section class="lg-wrap bf-sec" id="polos" aria-labelledby="bf-polos-h">
  <h2 class="bf-h" id="bf-polos-h">{{ s.polo_title }}</h2>
  <p class="bf-l">{{ s.polo_line }}</p>
  <div class="bf-polos">
    {%- for block in polos -%}{%- assign p = block.settings.product -%}{%- if p != blank -%}
    <article class="bf-polo" {{ block.shopify_attributes }}>
      <a class="bf-polo-ph" href="{{ p.url }}"><img src="{{ p.featured_image | image_url: width: 600 }}" alt="{{ p.title | escape }}" loading="lazy"></a>
      <h3><a href="{{ p.url }}">{{ p.title | remove: ' Classic Polo' | remove: ' Blade Polo' }}</a></h3>
      <p class="bf-polo-pr"><b>${{ s.polo_price }}</b> <s>{{ p.price | money_without_trailing_zeros }}</s></p>
      <div class="bf-chips">
        {%- for v in p.variants -%}<button type="button" class="bf-chip bf-chip-sm" data-polo="{{ v.id }}"{% unless v.available %} disabled aria-disabled="true"{% endunless %}>{{ v.title }}</button>{%- endfor -%}
      </div>
    </article>
    {%- endif -%}{%- endfor -%}
  </div>
</section>
{%- endif -%}

<section class="lg-wrap bf-sec bf-shipq" id="questions" aria-labelledby="bf-q-h">
  <div class="bf-ship">
    <h2 class="bf-h bf-h-sm">{{ s.ship_title }}</h2>
    <ol class="bf-tl">
      <li><b>Order placed</b><span data-tl-0>today</span></li>
      <li><b>Packed in Texas</b><span data-tl-1></span></li>
      <li><b>At your door</b><span data-tl-2></span></li>
    </ol>
    <p class="bf-l">{{ s.ship_line | replace: '[ship]', ship | replace: '[std]', s.xmas_std | replace: '[exp]', s.xmas_exp }}</p>
  </div>
  <div class="bf-faq">
    <h2 class="bf-h bf-h-sm" id="bf-q-h">{{ s.faq_title }}</h2>
    <div class="lg-faq">
      {%- for i in (1..6) -%}
        {%- assign qk = 'q' | append: i -%}{%- assign ak = 'a' | append: i -%}
        {%- if s[qk] != blank -%}
        <details class="lg-fq"><summary>{{ s[qk] }}</summary><div class="lg-fq-a"><p>{% if i == 3 and s.gifts_gone %}{{ s.a3_gone }}{% else %}{{ s[ak] | replace: '[ship]', ship }}{% endif %}</p></div></details>
        {%- endif -%}
      {%- endfor -%}
    </div>
  </div>
</section>

<section class="bf-list" id="list" data-bf-list hidden aria-labelledby="bf-list-h">
  <div class="lg-wrap bf-list-in">
    <div>
      <p class="bf-stamp">{{ s.list_stamp }}</p>
      <h2 class="bf-h bf-h-sm" id="bf-list-h"><span data-bf-show="mail">{{ s.list_title_before }}</span><span data-bf-show="list live cm over" hidden>{{ s.list_title_after }}</span></h2>
      <p class="bf-l"><span data-bf-show="mail">{{ s.list_line_before }}</span><span data-bf-show="list live cm over" hidden>{{ s.list_line_after }}</span></p>
    </div>
    <form class="bf-form" data-bf-form novalidate>
      <label class="sr" for="bf-email">Email</label>
      <input id="bf-email" name="email" type="email" inputmode="email" autocomplete="email" placeholder="you@email.com" required>
      <button type="submit" class="lg-btn">{{ s.list_btn }}</button>
      <p class="bf-form-msg" data-bf-form-msg hidden></p>
    </form>
  </div>
</section>

<section class="bf-sign">
  <p class="bf-sign-t">It's better to be lucky.</p>
  <p class="bf-l">{{ s.sign_line }}</p>
  <a class="lg-btn" href="#build">{{ s.hero_btn }}</a>
</section>

<div class="bf-bar" data-bf-bar hidden>
  <div class="bf-bar-in">
    <div class="bf-bar-txt"><b data-bar-total></b><span data-bar-sub></span></div>
    <button type="button" class="lg-btn" data-bar-add>{{ s.bar_btn }}</button>
  </div>
  <p class="bf-bar-nudge" data-bar-nudge hidden></p>
</div>
</div>

<script>
window.LG_BF = {
  phases: [['list', {{ s.list_start | json }}], ['live', {{ s.live_start | json }}], ['cm', {{ s.cm_start | json }}], ['over', {{ s.end | json }}]],
  end: {{ s.end | json }},
  clockHours: {{ s.clock_hours | default: 48 }},
  codes: { mail: {{ s.mail_code | json }}, list: {{ s.list_code | json }} },
  autoSources: {{ s.auto_sources | json }},
  giftsGone: {{ s.gifts_gone | json }},
  ship: {{ ship | times: 100 }},
  lowAt: {{ s.low_at | default: 60 }},
  sets: {{ s.sets | json }},
  say: { add: {{ s.set_btn | json }}, bar: {{ s.bar_btn | json }}, lad1Mail: {{ s.lad_1_mail | json }} },
  klaviyo: { key: {{ settings.lg_klaviyo_public_key | json }}, list: {{ s.klaviyo_list | default: settings.lg_klaviyo_list | json }} },
  clubs: [
    {%- for block in section.blocks -%}{%- if block.type == 'club' or block.type == 'drop' -%}{%- assign b = block.settings -%}{%- assign p = b.product -%}
    {%- if p != blank -%}
    {%- assign cut = p.metafields.custom.cutout.value -%}
    {%- if block.type == 'drop' %}{% assign isdrop = true %}{% else %}{% assign isdrop = false %}{% endif -%}
    { key: {{ b.key | json }}, drop: {{ isdrop }}, name: {{ b.name | default: p.title | json }}, line: {{ b.line | json }}, finish: {{ b.finish | json }}, url: {{ p.url | json }},
      img: {% if b.image != blank %}{{ b.image | image_url: width: 600 | json }}{% elsif cut != blank %}{{ cut | image_url: width: 600 | json }}{% else %}{{ p.featured_image | image_url: width: 600 | json }}{% endif %},
      opts: {{ p.options | json }},
      variants: [{%- for v in p.variants -%}{ id: {{ v.id }}, o: {{ v.options | json }}, a: {{ v.available }}, q: {{ v.inventory_quantity | default: 0 }}, p: {{ v.price }}, img: {% if v.featured_image %}{{ v.featured_image | image_url: width: 600 | json }}{% else %}null{% endif %} }{% unless forloop.last %},{% endunless %}{%- endfor -%}] },
    {%- endif -%}
    {%- endif -%}{%- endfor -%}
    null
  ].filter(Boolean)
};
</script>
{{ 'lg-bfcm.css' | asset_url | stylesheet_tag }}
<script src="{{ 'lg-bfcm.js' | asset_url }}" defer></script>

{% schema %}
{
  "name": "Black Friday page",
  "tag": "section",
  "class": "lg-scope",
  "settings": [
    { "type": "paragraph", "content": "One page for every phase. Dates are Central time, written like 2026-11-24T00:00:00-06:00. The discount itself is the Lucky Discounts app (Discounts in admin)." },
    { "type": "header", "content": "Dates" },
    { "type": "text", "id": "list_start", "label": "List early access starts", "default": "2026-11-24T00:00:00-06:00" },
    { "type": "text", "id": "live_start", "label": "Black Friday for everyone starts", "default": "2026-11-26T00:00:00-06:00" },
    { "type": "text", "id": "cm_start", "label": "Cyber Monday starts", "default": "2026-11-30T00:00:00-06:00" },
    { "type": "text", "id": "end", "label": "Deal ends", "default": "2026-12-01T00:00:00-06:00" },
    { "type": "range", "id": "clock_hours", "label": "Show the countdown only inside the last (hours)", "min": 0, "max": 120, "step": 12, "default": 48 },
    { "type": "text", "id": "xmas_std", "label": "Order by (standard) for Christmas", "default": "Dec 13" },
    { "type": "text", "id": "xmas_exp", "label": "Order by (expedited)", "default": "Dec 16" },
    { "type": "header", "content": "Codes and gifts" },
    { "type": "text", "id": "mail_code", "label": "Direct mail code", "default": "LUCKYMAIL" },
    { "type": "text", "id": "list_code", "label": "List early access code", "info": "Empty: the list phase shows the mail code." },
    { "type": "text", "id": "auto_sources", "label": "utm_source values that get the code applied for them", "default": "postpilot" },
    { "type": "number", "id": "gift_sets_left", "label": "Gift sets left (towel + divot tool)", "default": 400, "info": "Towels and divot tools are not Shopify products yet, so this is typed in. 0 hides the count." },
    { "type": "checkbox", "id": "gifts_gone", "label": "Towels and divot tools are gone", "default": false, "info": "Tick when stock hits zero: gift copy comes off every phase." },
    { "type": "text", "id": "gone_deal", "label": "Deal line once gifts are gone", "default": "Gifts are gone. $50 off 2 clubs, $100 off 3 or more still on." },
    { "type": "range", "id": "low_at", "label": "Show Running low under this many units", "min": 10, "max": 200, "step": 10, "default": 60 },
    { "type": "header", "content": "Top line" },
    { "type": "text", "id": "top_mail", "label": "Mail", "default": "Your postcard got you in a month early. LUCKYMAIL is on." },
    { "type": "text", "id": "top_list", "label": "List", "default": "List members only until Thursday. Everyone else waits." },
    { "type": "text", "id": "top_live", "label": "Black Friday", "default": "Black Friday is on. Ends Monday 11:59pm Central. Three clubs ship free." },
    { "type": "text", "id": "top_cm", "label": "Cyber Monday", "default": "Last day. Ends tonight at midnight Central." },
    { "type": "text", "id": "top_over", "label": "After", "default": "Order by [std] to have it under the tree. [exp] expedited." },
    { "type": "header", "content": "Hero" },
    { "type": "image_picker", "id": "hero_image", "label": "Hero photo", "info": "Empty: the night-shoot Carver (lg-bf-hero-2400.jpg in assets)." },
    { "type": "text", "id": "hero_alt", "label": "Hero photo alt text", "default": "Gold Carver 02 wedge on wet pavement at night" },
    { "type": "text", "id": "hero_btn", "label": "Hero button", "default": "Build my set" },
    { "type": "text", "id": "hero_btn2", "label": "Hero second link", "default": "Or grab a ready set" },
    { "type": "text", "id": "nocode_line", "label": "No-code line", "default": "No code. It comes off in your bag." },
    { "type": "text", "id": "ends_line", "label": "Ends line (before the countdown shows)", "default": "Ends Cyber Monday, Nov 30, midnight Central." },
    { "type": "text", "id": "clock_label", "label": "Countdown label", "default": "Ends in" },
    { "type": "text", "id": "lad_1", "label": "Ladder: 1 club", "default": "Our everyday price" },
    { "type": "text", "id": "lad_1_mail", "label": "Ladder: 1 club, postcard visitors", "default": "Free towel + divot tool" },
    { "type": "text", "id": "lad_2", "label": "Ladder: 2 clubs", "default": "$50 off + towel and divot tool" },
    { "type": "text", "id": "lad_3", "label": "Ladder: 3 or more", "default": "$100 off + gifts + free shipping" },
