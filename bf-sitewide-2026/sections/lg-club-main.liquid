{%- comment -%} editable: theme-editor settings first, club_page fallback {%- endcomment -%}
{%- comment -%}
  The club fold: breadcrumb, gallery, buy box, sticky bar and the modals.
  Live from the product: title, price, variants (hand, loft and grind), stock, reviews.
  Per club words and photos: the product metafield custom.club_page (json, see tools/theme/club_data.py).
  Sold out -> "Tell me when it's back" (Klaviyo, data-notify). custom.sold_out_mode = preorder and a
  variant at 0 that Shopify still sells -> "Pre-order, ships in {month of custom.restock_date}".
{%- endcomment -%}
{%- liquid
  assign c = product.metafields.custom.club_page.value
  assign s = section.settings
  assign min = settings.lg_review_min | default: 10
  assign rc = product.metafields.reviews.rating_count.value | default: 0
  assign rv = product.metafields.reviews.rating.value.rating
  assign mode = product.metafields.custom.sold_out_mode.value | default: 'notify' | downcase
  assign today = 'now' | date: '%Y-%m-%d'
  assign rd = product.metafields.custom.restock_date.value
  assign month = ''
  if rd != blank
    assign rds = rd | date: '%Y-%m-%d'
    if rds >= today
      assign month = rd | date: '%B'
    endif
  endif
  assign hi = -1
  assign li = -1
  assign fi = -1
  for o in product.options_with_values
    assign on = o.name | downcase
    if on contains 'hand'
      assign hi = forloop.index0
    elsif on contains 'loft'
      assign li = forloop.index0
    elsif on contains 'finish'
      assign fi = forloop.index0
    endif
  endfor
  assign badge = product.metafields.custom.badge.value
  assign badge_foil = product.metafields.custom.badge_foil.value
  assign wedge = false
  if li > -1
    assign wedge = true
  endif
  assign v0 = product.selected_or_first_available_variant
  assign price = v0.price | money_without_trailing_zeros
  assign atc = s.p_atc | default: c.atc | default: s.atc
  assign p_eyebrow = s.p_eyebrow | default: c.eyebrow
  assign p_h1 = s.p_h1 | default: c.h1 | default: product.title
  assign p_lede = s.p_lede | default: c.lede | default: product.description | strip_html
  assign p_tag = s.p_tag | default: c.gallery_tag
  assign rv0 = s.p_rvl_q | default: c.rvl[0]
  assign rv1 = s.p_rvl_n | default: c.rvl[1]
  assign rv2 = s.p_rvl_l | default: c.rvl[2]
  assign mon_img = product.metafields.custom.club_spec_photo.value | default: product.metafields.custom.cutout.value
  assign title_plain = product.title
  comment
    Carver sets offer (Theme settings > Carver sets offer, snippets/lg-cs): the strip, the set price and the suggested lofts, shown only while it runs
  endcomment
  assign cs_here = false
  assign csp = settings.cs_product | default: all_products['lucky-golf-lgw02-gold']
  if wedge and settings.cs_on and product.id == csp.id
    assign cs_here = true
  endif
-%}
<nav class="crumb lg-wrap" aria-label="Breadcrumb"><ol>
  <li><a href="{{ routes.root_url }}">Home</a></li>
  {%- if s.crumb_url != blank %}<li><a href="{{ s.crumb_url }}">{{ s.crumb_label }}</a></li>{% endif -%}
  {%- if wedge and s.crumb2_url != blank %}<li><a href="{{ s.crumb2_url }}">{{ s.crumb2_label }}</a></li>{% endif -%}
  <li><span aria-current="page">{{ product.title }}</span></li>
</ol></nav>

<div class="lg-wrap">
<div class="pdp">
  <div>
    <div class="gal" data-gal aria-label="Product images">
      {%- comment -%} The gallery is the product's own media, in the product's order, with Shopify's alt text:
        add or reorder photos in the product admin and the page follows. The card cutout (custom.cutout) leads. {%- endcomment -%}
      {%- assign cut = product.metafields.custom.cutout.value -%}
      {%- assign tiles = 0 -%}
      {%- if cut != blank -%}{%- assign tiles = 1 -%}
        <figure class="cut wide" data-mid="cut" data-zoom="{{ cut | image_url: width: 2000 }}">{{ cut | image_url: width: 1200 | image_tag: alt: product.title, loading: 'eager', widths: '500,800,1200', sizes: '(max-width: 749px) 86vw, 30vw' }}
          {%- if badge != blank and badge_foil %}<span class="lg-tag is-foil">{{ badge }}</span>{% endif -%}</figure>
      {%- endif -%}
      {%- for m in product.media -%}
        {%- assign alt = m.alt | default: product.title -%}
        {%- assign lz = 'lazy' -%}{%- if tiles == 0 %}{% assign lz = 'eager' %}{% endif -%}
        {%- assign tiles = tiles | plus: 1 -%}
        {%- assign more = '' -%}{%- if tiles > 5 %}{% assign more = ' is-more' %}{% endif -%}
        {%- comment -%} A photo belongs to a finish when the alt text before its first comma names it
          ("Carver 02 Black, face on"). A finish with photos of its own shows only those; the rest show the untagged ones. {%- endcomment -%}
        {%- assign mf = '' -%}
        {%- if fi > -1 -%}{%- assign ahead = m.alt | split: ',' | first | downcase -%}
          {%- for fv in product.options_with_values[fi].values -%}{%- assign fvd = fv | downcase -%}{%- if ahead contains fvd %}{% assign mf = fv %}{% endif -%}{%- endfor -%}
        {%- endif -%}
        {%- case m.media_type -%}
          {%- when 'image' -%}
          <figure class="{% if m.aspect_ratio > 1.2 %}wide{% endif %}{{ more }}" data-mid="{{ m.id }}"{% if mf != blank %} data-fin="{{ mf | escape }}"{% endif %} data-zoom="{{ m | image_url: width: 2000 }}">{{ m | image_url: width: 1200 | image_tag: alt: alt, loading: lz, widths: '500,800,1200,1600', sizes: '(max-width: 749px) 86vw, (max-width: 980px) 50vw, 30vw' }}</figure>
          {%- when 'video' -%}
          <figure class="wide is-video{{ more }}"{% if mf != blank %} data-fin="{{ mf | escape }}"{% endif %}>{{ m | video_tag: controls: true, muted: true, playsinline: true, preload: 'metadata', image_size: '1200x' }}</figure>
          {%- when 'external_video' -%}
          <figure class="wide is-video{{ more }}"{% if mf != blank %} data-fin="{{ mf | escape }}"{% endif %}>{{ m | external_video_tag }}</figure>
        {%- endcase -%}
      {%- endfor -%}
    </div>
    <div class="dots" data-dots aria-hidden="true">{%- if cut != blank %}<i></i>{% endif -%}{%- for m in product.media -%}<i></i>{%- endfor -%}</div>
    {%- if tiles > 5 -%}<button type="button" class="lg-btn-line gal-all" data-gal-all aria-expanded="false" data-tpl="{{ s.gal_all | default: 'See all [n] photos' | escape }}">{{ s.gal_all | default: 'See all [n] photos' | replace: '[n]', tiles }}</button>{%- endif -%}
  </div>

  <div class="buy" id="buy">
    {%- if badge != blank and badge_foil != true %}<span class="lg-tag pdp-badge">{{ badge }}</span>{% endif -%}
    {%- if p_eyebrow != blank %}<p class="lg-eyebrow">{{ p_eyebrow }}</p>{% endif -%}
    <h1 class="lg-d1">{{ p_h1 | replace: '<em>', '<span class="lg-foil-word">' | replace: '</em>', '</span>' }}</h1>
    {%- if rc >= min and rv -%}
      <div class="rvl"><span class="lg-stars" aria-label="{{ rv | times: 10 | floor | divided_by: 10.0 }} out of 5">{% render 'lg-stars' %}</span>
        {%- if rv0 != blank -%}<a href="#reviews">&ldquo;{{ rv0 }}&rdquo; {{ rv1 }} · {{ rv2 }}</a>{%- else -%}<a href="#reviews">{{ rc }} reviews</a>{%- endif -%}</div>
    {%- endif -%}
    <div class="price"><b data-price>{{ price }}</b>{% render 'lg-was', product: product, variant: v0 %}{% if wedge %}<span data-price-note hidden>each</span>{% endif %}</div>
    <p class="lg-body" data-lede>{{ p_lede }}</p>

    {%- if wedge and fi > -1 -%}
    {%- comment -%} Finish = a variant option (Carver 02: Gold / Black, 2026-10-08). Name, tag, photo and
      line per finish: the "Finish" blocks of this section, matched on the option value. {%- endcomment -%}
    <div class="row"><span class="lg-label">Finish</span></div>
    <div class="fins2" data-fins role="group" aria-label="Finish">
      {%- for o in product.options_with_values -%}{%- if forloop.index0 == fi -%}{%- for v in o.values -%}
        {%- assign fb = nil -%}{%- assign vv = v | downcase | strip -%}
        {%- for b in section.blocks -%}{%- if b.type == 'finish' -%}{%- assign bv = b.settings.value | downcase | strip -%}{%- if bv == vv %}{% assign fb = b %}{% endif -%}{%- endif -%}{%- endfor -%}
        <button type="button" class="fin2" data-f="{{ v | escape }}" aria-pressed="false"{% if fb %} {{ fb.shopify_attributes }}{% endif %}>
          {%- if fb.settings.tag != blank %}<i class="fin2-tag">{{ fb.settings.tag }}</i>{% endif -%}
          <span class="fin2-ph">{%- if fb.settings.image != blank -%}{{ fb.settings.image | image_url: width: 240 | image_tag: alt: '' }}{%- endif -%}</span>
          <b>{{ fb.settings.name | default: v }}</b><span class="fin2-x" data-fx></span>
        </button>
      {%- endfor -%}{%- endif -%}{%- endfor -%}
    </div>
    {%- elsif c.finishes.size > 1 -%}
    <div class="row"><span class="lg-label">Finish</span></div>
    <div class="fins">
      {%- for fi in c.finishes -%}{%- assign fp = all_products[fi.handle] -%}
      <a class="fin" href="{{ fp.url | default: '#' }}"{% if fi.handle == product.handle %} aria-current="page"{% endif %}><span class="lg-swatch">{%- assign sw = fp.metafields.custom.club_swatch.value | default: fp.metafields.custom.cutout.value -%}{%- if sw != blank %}{{ sw | image_url: width: 144 | image_tag: alt: '' }}{% endif -%}</span><b>{{ fi.label }}</b></a>
      {%- endfor -%}
    </div>
    {%- endif -%}

    {%- if wedge -%}
    <div class="row"><span class="lg-label">Hand</span></div>
    <div class="hands2" data-hand role="group" aria-label="Hand"></div>
    <div class="row" id="lofts"><span class="lg-label">Loft and grind</span><a href="#" data-md-open="md-helper">Help me pick &rarr;</a></div>
    <p class="pickhint" data-pickhint aria-live="polite">{{ s.pick_hint | default: 'Tap one, or tap a few to build a set.' }}</p>
    <div class="lofts lofts2" data-lofts role="group" aria-label="Loft and grind"></div>
    <div class="cs-swap" data-swap hidden aria-live="polite"></div>
    {%- else -%}
      {%- comment -%} 2026-10-09 (Cole): same quiet Right / Left boxes as the wedges, always shown; a hand the club isn't made in is struck through. {%- endcomment -%}
      {%- for o in product.options_with_values -%}{%- assign ishand = false -%}{%- if forloop.index0 == hi %}{% assign ishand = true %}{% endif -%}
      {%- if o.values.size > 1 or ishand -%}
        {%- assign ol = o.name -%}{%- if ishand %}{% assign ol = 'Hand' %}{% endif -%}
        <div class="row"><span class="lg-label">{{ ol }}{% unless ishand %} <span class="m" data-pick="{{ forloop.index0 }}"></span>{% endunless %}</span></div>
        <div class="lg-chips{% if ishand %} hands2{% endif %}" data-opt="{{ forloop.index0 }}" role="group" aria-label="{{ ol | escape }}">
          {%- for v in o.values -%}{%- assign vl = v -%}{%- if ishand -%}{%- if v contains 'Left' %}{% assign vl = 'Left' %}{% elsif v contains 'Right' %}{% assign vl = 'Right' %}{% endif -%}{%- endif -%}
          <button class="lg-chip" type="button" data-v="{{ v | escape }}" aria-label="{{ vl | escape }}{% if ishand %} hand{% endif %}">{{ vl }}</button>
          {%- endfor -%}
          {%- if ishand and o.values.size == 1 -%}{%- assign only = o.values.first | downcase -%}
            {%- if only contains 'right' -%}<button class="lg-chip" type="button" data-v="" data-none data-dead aria-disabled="true" aria-label="Left hand, not made in this club">Left</button>
            {%- elsif only contains 'left' -%}<button class="lg-chip" type="button" data-v="" data-none data-dead aria-disabled="true" aria-label="Right hand, not made in this club">Right</button>{%- endif -%}
          {%- endif -%}
        </div>
      {%- endif -%}{%- endfor -%}
    {%- endif -%}

    {%- comment -%} Carver sets, Vice-style: 1 / 2 / 3 wedge cards with the set price. Tapping one builds the set with in-stock lofts. {%- endcomment -%}
    {%- if cs_here -%}<div class="cs-pdp" data-cs-show="on"><div class="cs-pdp-hd"><span class="lg-label">{{ settings.cs_strip }}</span><a href="{{ settings.cs_url | default: '/pages/carver-sets' }}">{% if settings.cs_url contains 'black-friday' %}See the deals{% else %}Ready-made sets{% endif %} &rarr;</a></div><div class="cs-pdp-tiles" data-cs-tiles role="group" aria-label="How many wedges"></div></div>{%- elsif settings.cs_on and settings.cs_url contains 'black-friday' -%}<div class="cs-pdp bf-pdp" data-cs-show="on"><div class="cs-pdp-hd"><span class="lg-label">{{ settings.cs_strip }}</span><a href="{{ settings.cs_url }}">See the deals &rarr;</a></div><div class="cs-pdp-tiles"><span class="cs-pdp-t"><span>1 club</span><b>Everyday</b><small>price</small></span><span class="cs-pdp-t"><span>2 clubs</span><b>${{ settings.cs_t2 }} off</b><small>+ towel + divot</small></span><span class="cs-pdp-t"><i>Best value</i><span>3 or more</span><b>${{ settings.cs_t3 }} off</b><small>+ gifts, ships free</small></span></div></div>{%- endif -%}
    {%- if settings.cs_on and settings.cs_url contains 'black-friday' -%}<a class="bf-soon" href="{{ settings.cs_url }}" data-cs-show="soon"><b>Early Black Friday starts Nov 1.</b> ${{ settings.cs_t2 }} off two clubs, ${{ settings.cs_t3 }} off three, plus a free towel and divot tool. <span>See the deals &rarr;</span></a>{%- endif -%}
    <form class="cta" method="post" action="{{ routes.cart_add_url }}" data-lg-add data-club-form>
      <input type="hidden" name="id" value="{{ v0.id }}" data-vid>
      <input type="hidden" name="properties[Pre-order]" value="" data-preprop disabled>
      <button class="lg-btn" type="submit" data-atc>{{ atc }} · {{ price }}</button>
    </form>
    {%- if cs_here -%}<p class="cs-set" data-cs-set hidden aria-live="polite"></p>{%- endif -%}
    <div class="trustl"><span class="lg-stock{% unless product.available %} is-out{% endunless %}" data-stockline>{% if product.available %}{{ s.in_stock }}{% else %}Sold out{% endif %}</span><span class="trustl-links">
      {%- if c.modals -%}<a href="#" data-md-open="md-returns">{{ s.returns_link }}</a><a href="#" data-md-open="md-delivery">{{ s.delivery_link }}</a>
      {%- else -%}<a href="{{ s.returns_url }}">{{ s.returns_link }}</a><a href="{{ s.ship_url }}">{{ s.ship_link }}</a>{%- endif -%}</span></div>

    {%- assign nd = 0 -%}{%- for k in (1..3) -%}{%- assign kt = 'p_d' | append: k | append: '_t' -%}{%- assign dt = s[kt] | default: c.details[forloop.index0][0] -%}{%- if dt != blank %}{% assign nd = nd | plus: 1 %}{% endif -%}{%- endfor -%}
    {%- if nd > 0 -%}
    <div class="lg-faq">
      {%- for k in (1..3) -%}{%- assign kt = 'p_d' | append: k | append: '_t' -%}{%- assign kb = 'p_d' | append: k | append: '_b' -%}{%- assign dt = s[kt] | default: c.details[forloop.index0][0] -%}{%- assign db = s[kb] | default: c.details[forloop.index0][1] -%}{%- if dt != blank -%}<details class="lg-fq"><summary>{{ dt }}</summary><div class="lg-fq-a"><p>{{ db }}</p></div></details>{%- endif -%}{%- endfor -%}
    </div>
    {%- endif -%}
  </div>
</div>
</div>

<div class="stickybar" data-sticky>
  <span class="sb-ph">{%- if mon_img != blank %}{{ mon_img | image_url: width: 144 | image_tag: alt: '' }}{% endif -%}</span>
  <div><b data-sticky-name>{{ product.title }}</b><span data-sticky-price>{{ price }}</span></div>
  <div class="sb-pick" data-sb-pick>
    {%- if wedge -%}
    <label><span class="sr">Hand</span><select class="sb-sel" data-sb-hand></select></label>
    <label><span class="sr">Loft and grind</span><select class="sb-sel" data-sb-loft></select></label>
    {%- else -%}
      {%- for o in product.options_with_values -%}{%- if o.values.size > 1 -%}
      <label><span class="sr">{{ o.name }}</span><select class="sb-sel" data-sb-opt="{{ forloop.index0 }}">{%- for v in o.values -%}<option value="{{ v | escape }}">{{ v }}</option>{%- endfor -%}</select></label>
      {%- endif -%}{%- endfor -%}
    {%- endif -%}
  </div>
  <a class="sb-change" href="{% if wedge %}#lofts{% else %}#buy{% endif %}" data-sb-change>Change</a>
  <button class="lg-btn" type="button" data-atc-sticky>{{ atc }}</button>
</div>

{%- if wedge -%}
<div class="md" id="md-helper" hidden role="dialog" aria-modal="true" aria-labelledby="md-helper-t"><div class="md-bd" data-md-close></div><div class="md-panel hp">
  <button type="button" class="md-x" data-md-close aria-label="Close">&times;</button>
  <h2 class="lg-d3" id="md-helper-t">{{ s.helper_title }}</h2>
  <p>{{ s.helper_line }}</p>
  <div data-helper></div>
</div></div>
{%- endif -%}
<div class="md" id="md-notify" hidden role="dialog" aria-modal="true" aria-labelledby="md-notify-t"><div class="md-bd" data-md-close></div><div class="md-panel">
  <button type="button" class="md-x" data-md-close aria-label="Close">&times;</button>
  <h2 class="lg-d3" id="md-notify-t">Tell me when it's back</h2>
  <p data-notify-line>{{ s.notify_line }}</p>
  <form class="lg-form" data-notify data-variant="{{ v0.id }}" novalidate><label class="sr" for="notify-email">Email</label><input class="lg-input" id="notify-email" type="email" placeholder="you@somewhere.com" autocomplete="email" required><button class="lg-btn-line" type="submit">Tell me</button></form>
</div></div>
{%- if rc >= min and c.rv.write -%}
<div class="md" id="md-write" hidden role="dialog" aria-modal="true" aria-labelledby="md-write-t"><div class="md-bd" data-md-close></div><div class="md-panel">
  <button type="button" class="md-x" data-md-close aria-label="Close">&times;</button>
  <h2 class="lg-d3" id="md-write-t">Write a review</h2>
  <p>{{ s.write_line }}</p>
  <div class="md-foot"><button type="button" class="lg-btn-line lg-btn-sm" data-md-close>Close</button></div>
</div></div>
{%- endif -%}

{%- if c.modals -%}
<div class="md" id="md-returns" hidden role="dialog" aria-modal="true" aria-labelledby="md-returns-t"><div class="md-bd" data-md-close></div><div class="md-panel">
  <button type="button" class="md-x" data-md-close aria-label="Close">&times;</button>
  <p class="lg-eyebrow">Refund policy</p>
  <h2 class="lg-d3" id="md-returns-t">{{ s.returns_link }}</h2>
  {{ s.returns_body }}
</div></div>
<div class="md" id="md-delivery" hidden role="dialog" aria-modal="true" aria-labelledby="md-delivery-t"><div class="md-bd" data-md-close></div><div class="md-panel">
  <button type="button" class="md-x" data-md-close aria-label="Close">&times;</button>
  <p class="lg-eyebrow">Delivery</p>
  <h2 class="lg-d3" id="md-delivery-t">When it shows up</h2>
  <div class="md-carriers"><span class="lg-tag">USPS</span><span class="lg-tag">UPS</span><span class="lg-tag">FedEx</span></div>
  {{ s.delivery_body }}
</div></div>
{%- endif -%}
<dialog class="zoom" id="zoom" aria-label="Image"><button type="button" class="md-x" data-zoom-close aria-label="Close" style="position:absolute">&times;</button><img src="" alt=""></dialog>

<script>
window.LG_CLUB = {
  title: {{ product.title | json }}, pid: {{ product.id }}, cs: {{ cs_here }},
  wedge: {{ wedge }}, hi: {{ hi }}, li: {{ li }}, fi: {{ fi }},
  fins: [{%- for b in section.blocks -%}{%- if b.type == 'finish' -%}{ v: {{ b.settings.value | json }}, n: {{ b.settings.name | json }}, l: {{ b.settings.lede | json }} },{%- endif -%}{%- endfor -%}],
  fullHint: {{ s.full_hint | default: "That's 3. Tap one to drop it first." | json }},
  pickLine: {{ s.pick_line | default: 'Pick a loft' | json }},
  grind: {{ c.grind_default | default: 'K' | json }},
  sheet: {{ c.spec.sheet | json }}, headg: {{ c.spec.head_g | default: '' | json }},
  atc: {{ atc | json }}, inStock: {{ s.in_stock | json }},
  mode: {{ mode | json }}, month: {{ month | json }},
  free: {{ settings.lg_free_shipping | default: 195 | json }},
  start: {{ product.selected_variant.id | default: 0 }},
  variants: [
    {%- for v in product.variants -%}
    { id: {{ v.id }}, i: {{ v.featured_media.id | default: 0 }}, o: {{ v.options | json }}, a: {{ v.available }}, q: {{ v.inventory_quantity | default: 0 }}, c: {{ v.inventory_policy | json }}, m: {{ v.inventory_management | json }}, p: {{ v.price }} }{% unless forloop.last %},{% endunless %}
    {%- endfor -%}
  ]
};
</script>
<script>
/* The club buy box (templates/product.club.json). Data: window.LG_CLUB, written by the section from
   the product's live variants. Wedges (a Loft option): hand, loft chips, 1 to 3 wedge sets, the
   readout and the helper. Everything else: one chip row per option with more than one value. */
document.addEventListener('DOMContentLoaded', function(){
  var D = window.LG_CLUB; if (!D) return;
  var $ = function(s, r){ return (r || document).querySelector(s); };
  var $$ = function(s, r){ return [].slice.call((r || document).querySelectorAll(s)); };
  var esc = function(s){ return String(s == null ? '' : s).replace(/[&<>"]/g, function(c){ return {'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;'}[c]; }); };
  var money = function(c){ return '$' + (c % 100 ? (c / 100).toFixed(2) : Math.round(c / 100)); };
  var toast = function(m){ if (window.Lucky && Lucky.toast) Lucky.toast(m); };
  var form = $('[data-club-form]'), vid = $('[data-vid]'), pre = $('[data-preprop]'), btn = $('[data-atc]'), sticky = $('[data-sticky]');
  var nf = $('#md-notify form[data-notify]');
  /* a variant's state: in stock, pre-order (at 0, still sold, and the product is set to pre-order) or out */
  function st(v){
    if (!v || !v.a) return 'out';
    if (D.mode === 'preorder' && v.m && v.q <= 0 && v.c === 'continue') return 'pre';
    return 'in';
  }
  var backLine = function(){ return D.month ? 'Back in ' + D.month : 'Sold out'; };
  var preLine = function(){ return 'Pre-order' + (D.month ? ', ships in ' + D.month : ''); };
  var flash = false;
  function openNotify(v, what){
    if (nf && v) nf.setAttribute('data-variant', v.id);
    var l = $('[data-notify-line]');
    if (l){ if (!l.getAttribute('data-default')) l.setAttribute('data-default', l.textContent);
      /* "on its way back" only with a restock month; with no date it stays the plain line */
      l.textContent = what && D.month ? 'The ' + what + " is on its way back. Drop your email and you'll get one message when it lands." : l.getAttribute('data-default'); }
    var m = $('#md-notify'); if (m) m.hidden = false;
  }
  if (window.LuckyBag) LuckyBag.onChange(function(){ if (!flash) return; flash = false;
