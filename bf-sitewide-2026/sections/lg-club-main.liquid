    document.addEventListener('click', function(e){ var b = e.target.closest('[data-opt] button'); if (!b || b.hasAttribute('data-none')) return;
      pick[+b.closest('[data-opt]').getAttribute('data-opt')] = b.getAttribute('data-v'); paint(); });
    document.addEventListener('change', function(e){ var s = e.target.closest('[data-sb-opt]'); if (!s) return; pick[+s.getAttribute('data-sb-opt')] = s.value; paint(); });
    form.addEventListener('submit', function(e){
      var v = variant();
      if (st(v) === 'out'){ e.preventDefault(); e.stopPropagation(); openNotify(v); return; }
      flash = true;
    });
  })();

  /* the sticky bar: once the real button has scrolled away, until the footer */
  $('[data-atc-sticky]').addEventListener('click', function(){ if (form.requestSubmit) form.requestSubmit(); else btn.click(); });
  (function(){
    var ftr = $('.lg-ftr');
    function p(){ var on = form.getBoundingClientRect().bottom < 0 && (!ftr || ftr.getBoundingClientRect().top > innerHeight);
      if (on !== sticky.hasAttribute('data-on')){ sticky.toggleAttribute('data-on', on); if (window.Lucky && Lucky.guide && Lucky.guide.place) Lucky.guide.place(); } }
    addEventListener('scroll', p, { passive: true }); addEventListener('resize', p); p();
  })();

  /* gallery dots (phone) */
  (function(){ var g = $('[data-gal]'), d = $('[data-dots]'); if (!g || !d || !d.children.length) return;
    var vis = function(){ return [].filter.call(g.children, function(x){ return x.style.display !== 'none'; }).length; };
    /* more than eight photos: a "1 / 21" counter instead of a row of dots (2026-10-08) */
    var many = false;
    function build(){ var n = vis(); many = n > 8; d.classList.toggle('is-count', many); d.innerHTML = many ? '' : new Array(n + 1).join('<i></i>'); mark(); }
    function mark(){ var n = vis(), i = Math.min(n - 1, Math.round(g.scrollLeft / (g.scrollWidth / n)));
      if (many) d.textContent = (i + 1) + ' / ' + n; else [].forEach.call(d.children, function(x, k){ x.classList.toggle('on', k === i); }); }
    build(); g.addEventListener('scroll', mark, { passive: true }); g.addEventListener('lg:gal', build); })();

  /* the gallery shows five; the button opens the rest */
  var ga = $('[data-gal-all]');
  if (ga) ga.addEventListener('click', function(){ var g = $('[data-gal]'); g.classList.add('is-all'); ga.setAttribute('aria-expanded', 'true'); ga.hidden = true; });

  /* rails and tabs further down the page */
  document.addEventListener('click', function(e){
    var b = e.target.closest('[data-railarrows] button');
    if (b){ var r = $('[data-rail]:not([hidden])'); if (r) r.scrollBy({ left: (b.getAttribute('aria-label') === 'Next' ? 1 : -1) * 520, behavior: 'smooth' }); return; }
    var m = e.target.closest('[data-moodseg] button');
    if (m){ var mood = $('#finishes'), k = m.getAttribute('data-m');
      $$('[data-moodseg] button').forEach(function(x){ x.setAttribute('aria-pressed', String(x === m)); });
      mood.setAttribute('data-metal', k);
      $$('[data-mh]', mood).forEach(function(h){ h.hidden = h.getAttribute('data-mh') !== k; });
      $$('[data-rail]', mood).forEach(function(r){ r.hidden = r.getAttribute('data-rail') !== k; }); return; }
    var t = e.target.closest('[data-spectabs] button');
    if (t){ $$('[data-spectabs] button').forEach(function(x){ x.setAttribute('aria-pressed', String(x === t)); });
      $$('[data-spectab]').forEach(function(p){ p.hidden = p.getAttribute('data-spectab') !== t.getAttribute('data-tab'); }); return; }
    var g = e.target.closest('[data-specseg] button');
    if (g){ $$('[data-specseg] button').forEach(function(x){ x.setAttribute('aria-pressed', String(x === g)); });
      $$('[data-spec]').forEach(function(tb){ tb.hidden = tb.getAttribute('data-spec') !== g.getAttribute('data-g'); }); }
  });

  /* reviews: the proximity chart from the live Judge.me histogram, then the latest reviews */
  var R = window.LG_CLUB_REVIEWS;
  if (R && $('#prox') && window.Lucky && Lucky.proximity) Lucky.proximity($('#prox'), R.nums ? { counts: R.totals } : { counts: R.totals, nums: false });
  if (R && $('#jm-list')) (function(){
    /* Every review, paged live from Judge.me's public widget feed (the page itself only carries the
       latest 10). No star filter chips (Cole, 2026-10-08): sort + show more. */
    var sort = 'recent', page = 0, busy = false, done = false;
    var star = function(n){ return '★★★★★'.slice(0, n) + '☆☆☆☆☆'.slice(0, 5 - n); };
    var SORTS = { recent: 'sort_by=created_at&sort_dir=desc', high: 'sort_by=rating&sort_dir=desc', low: 'sort_by=rating&sort_dir=asc' };
    var strip = function(h){ var d = document.createElement('div'); d.innerHTML = h || ''; return (d.textContent || '').trim(); };
    function item(r){
      return '<div class="jm-item"><span class="lg-stars" aria-label="' + r.r + ' out of 5" style="line-height:1;color:var(--lg-star)">' + star(r.r) + '</span>' + (r.t ? '<b>' + esc(r.t) + '</b>' : '') + '<p>' + esc(r.q) + '</p><small>' + esc(r.n) + (r.v ? ' · Verified buyer' : '') + ' · ' + esc(r.d) + '</small></div>'; }
    function count(){ var n = $$('#jm-list .jm-item').length; $('#jm-count').textContent = 'Showing ' + n + ' of ' + R.total + '.'; $('#jm-more').hidden = done; }
    function load(reset){
      if (busy) return; busy = true;
      if (reset){ page = 0; done = false; $('#jm-list').innerHTML = ''; }
      var btn = $('#jm-more'); btn.disabled = true; btn.textContent = 'Loading…';
      var u = 'https://judge.me/reviews/reviews_for_widget?platform=shopify&per_page=10&url=' + R.shop + '&shop_domain=' + R.shop + '&product_id=' + R.pid + '&page=' + (page + 1) + '&' + SORTS[sort];
      fetch(u).then(function(x){ return x.json(); }).then(function(d){
        page = d.pagination ? d.pagination.current_page : page + 1;
        done = !d.pagination || page >= d.pagination.total_pages;
        $('#jm-list').insertAdjacentHTML('beforeend', (d.reviews || []).map(function(r){
          return item({ r: r.rating, t: r.title, q: strip(r.body_html), n: r.reviewer_name || 'Anonymous', v: r.verified_buyer, d: (r.created_at || '').slice(0, 10) }); }).join(''));
      }).catch(function(){
        /* blocked or offline: fall back to the 10 the page carries */
        if (!page) $('#jm-list').innerHTML = R.list.map(item).join(''); done = true;
      }).then(function(){ busy = false; btn.disabled = false; btn.textContent = 'Show more reviews'; count(); });
    }
    /* newest first: the 10 the page already carries show at once, Judge.me pages in from page 2 */
    function first(){ if (sort === 'recent' && R.list.length){ $('#jm-list').innerHTML = R.list.map(item).join(''); page = 1; done = R.total <= R.list.length; count(); } else load(true); }
    $('#jm-sort').addEventListener('change', function(){ sort = this.value; page = 0; $('#jm-list').innerHTML = ''; first(); });
    $('#jm-more').addEventListener('click', function(){ load(false); });
    $('[data-readall]').addEventListener('click', function(){ var jm = $('#jm'), o = !jm.hidden; jm.hidden = o; this.setAttribute('aria-expanded', String(!o)); $('i', this).textContent = o ? '+' : '−'; if (!o && !page) first(); });
  })();

  paint();
});

</script>

